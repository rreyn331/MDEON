#!/bin/sh
set -e

case "$1" in
    remove|purge)
        schema_override=/usr/share/glib-2.0/schemas/99-mdeon-panel-gnome-extension.gschema.override
        rm -f "$schema_override"
        if command -v glib-compile-schemas >/dev/null 2>&1 &&
            [ -d /usr/share/glib-2.0/schemas ]; then
            glib-compile-schemas /usr/share/glib-2.0/schemas
        fi
        ;;
esac

exit 0