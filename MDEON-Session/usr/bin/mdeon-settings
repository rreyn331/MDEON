# ----------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------
def run(cmd):
    try:
        subprocess.Popen(cmd, shell=True, start_new_session=True)
    except Exception as e:
        logger.error(f"Failed to execute command '{cmd}': {e}")

def has(cmd):
    return shutil.which(cmd) is not None

MDEON_SESSION_COMPONENTS = {"mdeon-desktop", "mdeon-panel"}

def available(candidates):
    out = []
    for item in candidates:
        if item == "none":
            out.append(item)
        elif item in MDEON_SESSION_COMPONENTS or has(item):
            out.append(item)
        elif "/" in item and Path(item).exists():
            out.append(item)
    return out

def quote_value(value):
    value = str(value)
    value = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{value}"'

def hex_to_rgb(hex_str, fallback=(0.18, 0.18, 0.18)):
    s = str(hex_str).strip().lstrip("#")
    try:
        if len(s) == 3:
            s = "".join(c * 2 for c in s)
        if len(s) == 6:
            return (int(s[0:2], 16) / 255.0, int(s[2:4], 16) / 255.0, int(s[4:6], 16) / 255.0)
    except Exception:
        pass
    return fallback

def rgb_to_hex(r, g, b):
    return f"#{int(round(r * 255)):02X}{int(round(g * 255)):02X}{int(round(b * 255)):02X}"

def shell_clean_exec(value):
    if not value:
        return ""
    return re.sub(r"\s+%[fFuUdDnNickvm]", "", value).strip()

def get_desktop_entry_value(path, key):
    try:
        for line in path.read_text(errors="ignore").splitlines():
            if line.startswith(key + "="):
                return line.split("=", 1)[1]
    except Exception:
        pass
    return ""

def set_desktop_entry_key(path, key, value):
    try:
        lines = path.read_text(errors="ignore").splitlines()
    except Exception:
        lines = []

    found = False
    out = []
    for line in lines:
        if line.startswith(key + "="):
            out.append(f"{key}={value}")
            found = True
        else:
            out.append(line)

    if not found:
        out.append(f"{key}={value}")

    path.write_text("\n".join(out) + "\n")

def desktop_entry_enabled(path):
    hidden = get_desktop_entry_value(path, "Hidden").lower()
    gnome_enabled = get_desktop_entry_value(path, "X-GNOME-Autostart-enabled").lower()
    return not (hidden == "true" or gnome_enabled == "false")

# ----------------------------------------------------------------------
# Config Handler
# ----------------------------------------------------------------------
class Config:
    def __init__(self):
        self.data = {}
        self.load()

    def ensure_exists(self):
        if CONF.exists():
            return
        CONF.parent.mkdir(parents=True, exist_ok=True)
        if DFLT.exists():
            shutil.copy(DFLT, CONF)
            CONF.chmod(0o644)
        else:
            CONF.write_text(self.default_text())

    def default_text(self):
        return """# MDEON user configuration

MDEON_NAME="MDEON"
FALLBACK_TERM="x-terminal-emulator"
AUTOSTART_MODE="sequential"
AUTOSTART_MANAGER="/usr/bin/mdeon-autostart"
AUTOSTART_MANAGER_OPTIONS="--session"

WALLPAPER=""
FALLBACK_COLOR="#FFB6C1"

VOLUME="pasystray"
VOLUME_OPTIONS=""
USE_VOLUME="true"

X11_VOLUME=""
X11_VOLUME_OPTIONS=""
X11_USE_VOLUME=""

WAYLAND_VOLUME=""
WAYLAND_VOLUME_OPTIONS=""
WAYLAND_USE_VOLUME=""

DESKTOP_MANAGER="mdeon-desktop"
DESKTOP_MANAGER_OPTIONS=""
USE_DESKTOP_MANAGER="true"

X11_DESKTOP_MANAGER="mdeon-desktop"
X11_DESKTOP_MANAGER_OPTIONS=""
X11_USE_DESKTOP_MANAGER="true"

WINDOW_MANAGER="xfwm4"
WINDOW_MANAGER_OPTIONS="--replace"

WINDOW_COMPOSITOR=""
WINDOW_COMPOSITOR_OPTIONS=""

FLWM_MENU_SCRIPT="/usr/bin/gen-flwm-menu.sh"

X11_DOCK_CMD="mdeon-panel"
X11_DOCK_CMD_OPTIONS=""

WAYLAND_COMPOSITOR="labwc"
WAYLAND_COMPOSITOR_OPTIONS=""
WAYLAND_DESKTOP_NAME="wlroots"

WAYLAND_DESKTOP_MANAGER="mdeon-desktop"
WAYLAND_DESKTOP_MANAGER_OPTIONS=""
WAYLAND_USE_DESKTOP_MANAGER="true"

MENU_SCRIPT="/usr/bin/gen-wayland-menu.sh"

WAYLAND_DOCK_CMD="mdeon-panel"
WAYLAND_DOCK_CMD_OPTIONS=""

DEBUG_LOG_DIR=""
DEBUG_LOG_MAX_FILES="5"
"""

    def load(self):
        self.ensure_exists()
        src = CONF if CONF.exists() else DFLT
        if not src.exists():
            return

        try:
            for line in src.read_text(errors="ignore").splitlines():
                stripped = line.strip()
                if not stripped or stripped.startswith("#") or "=" not in stripped:
                    continue
                key, value = stripped.split("=", 1)
                key = key.strip()
                value = value.strip()
                if len(value) >= 2 and value[0] == value[-1] and value[0] in ["'", '"']:
                    value = value[1:-1]
                value = value.replace('\\"', '"').replace("\\\\", "\\")
                self.data[key] = value
        except Exception as e:
            logger.error(f"Error loading config: {e}")

    def get(self, key, default=""):
        return self.data.get(key, default)

    def set(self, key, value):
        self.data[key] = str(value)

    def save(self):
        template = DFLT if DFLT.exists() else CONF
        if template.exists():
            lines = template.read_text(errors="ignore").splitlines()
        else:
            lines = self.default_text().splitlines()

        written = set()
        out = []
        for line in lines:
            stripped = line.strip()
            if stripped and not stripped.startswith("#") and "=" in stripped:
                key = stripped.split("=", 1)[0].strip()
                if key in self.data:
                    out.append(f"{key}={quote_value(self.data[key])}")
                    written.add(key)
                else:
                    out.append(line)
            else:
                out.append(line)

        for key in sorted(self.data.keys()):
            if key not in written:
                out.append(f"{key}={quote_value(self.data[key])}")

        CONF.parent.mkdir(parents=True, exist_ok=True)
        CONF.write_text("\n".join(out) + "\n")


# ----------------------------------------------------------------------
# Core Settings GUI Controller (Pure PyCairo)
# ----------------------------------------------------------------------
class MdeonSettingsCairo:
    TABS = ["Common", "X11", "Wayland", "Autostart", "Tools"]

    PALETTE_COLORS = [
        "#FFB6C1", "#FF6B6B", "#FA5252", "#E64980",
        "#BE4BDB", "#7950F2", "#4C6EF5", "#228BE6",
        "#15AABF", "#12B886", "#40C057", "#82C91E",
        "#FAB005", "#FD7E14", "#212529", "#1E1E2E",
        "#2D2D2D", "#343A40", "#495057", "#868E96",
        "#CED4DA", "#F8F9FA", "#FFFFFF", "#000000"
    ]

    def __init__(self, width, height, flush_cb):
        self.width = width
        self.height = height
        self.flush_cb = flush_cb

        self.cfg = Config()
        self.active_tab = 0
        self.status_msg = "Ready"
        self.status_time = time.time()
        self.scroll_y = 0
        self.max_scroll_y = 0
        self.scroll_x = 0
        self.max_scroll_x = 0
        self.scrollbar_dragging = False
        self.scrollbar_drag_offset = 0
        self.scrollbar = None
        self.horizontal_scrollbar_dragging = False
        self.horizontal_scrollbar_drag_offset = 0
        self.horizontal_scrollbar = None

        self.wp_path = self.autodetect_wallpaper()
        if self.wp_path:
            self.cfg.set("WALLPAPER", self.wp_path)

        # Form fields state
        self.form_values = {}
        self.dropdown_popup = None
        self.focused_entry = None
        self.cursor_visible = True

        # Modal State (e.g., Color Picker)
        self.modal_active = False
        self.modal_temp_color = "#FFB6C1"

        # Autostart list cache
        self.autostart_query = ""
        self.autostart_items = []
        self.refresh_autostart_list()

        # UI Hitboxes: List of tuples (x, y, w, h, handler_func, hover_id)
        self.interactive_rects = []
        self.hovered_id = None

        self.wp_preview_surface = None
        self._init_form_values()
        self.update_wallpaper_preview()
        self._init_cairo()

    def _init_cairo(self):
        self.surface = cairo.ImageSurface(cairo.FORMAT_RGB24, self.width, self.height)
        self.ctx = ThemedContext(cairo.Context(self.surface), prefers_light_scheme())
        self.stride = self.surface.get_stride()
        self.data_buffer = self.surface.get_data()

    def _init_form_values(self):
        self.form_values = {
            # Common
            "MDEON_NAME": self.cfg.get("MDEON_NAME", "MDEON"),
            "FALLBACK_TERM": self.cfg.get("FALLBACK_TERM", "x-terminal-emulator"),
            "AUTOSTART_MODE": self.cfg.get("AUTOSTART_MODE", "sequential"),
            "AUTOSTART_MANAGER": self.cfg.get("AUTOSTART_MANAGER", "/usr/bin/mdeon-autostart"),
            "AUTOSTART_MANAGER_OPTIONS": self.cfg.get("AUTOSTART_MANAGER_OPTIONS", "--session"),
            "FALLBACK_COLOR": self.cfg.get("FALLBACK_COLOR", "#FFB6C1"),
            "VOLUME": self.cfg.get("VOLUME", "pasystray"),
            "VOLUME_OPTIONS": self.cfg.get("VOLUME_OPTIONS", ""),
            "USE_VOLUME": self.cfg.get("USE_VOLUME", "true").lower() == "true",
            "DEBUG_LOG_DIR": self.cfg.get("DEBUG_LOG_DIR", ""),
            "DEBUG_LOG_MAX_FILES": self.cfg.get("DEBUG_LOG_MAX_FILES", "5"),

            # X11
            "X11_DESKTOP_MANAGER": self.cfg.get("X11_DESKTOP_MANAGER", "mdeon-desktop"),
            "X11_DESKTOP_MANAGER_OPTIONS": self.cfg.get("X11_DESKTOP_MANAGER_OPTIONS", ""),
            "X11_USE_DESKTOP_MANAGER": self.cfg.get("X11_USE_DESKTOP_MANAGER", "true").lower() == "true",
            "WINDOW_MANAGER": self.cfg.get("WINDOW_MANAGER", "xfwm4"),
            "WINDOW_MANAGER_OPTIONS": self.cfg.get("WINDOW_MANAGER_OPTIONS", "--replace"),
            "WINDOW_COMPOSITOR": self.cfg.get("WINDOW_COMPOSITOR", ""),
            "WINDOW_COMPOSITOR_OPTIONS": self.cfg.get("WINDOW_COMPOSITOR_OPTIONS", ""),
            "X11_DOCK_CMD": self.cfg.get("X11_DOCK_CMD", "mdeon-panel"),
            "X11_DOCK_CMD_OPTIONS": self.cfg.get("X11_DOCK_CMD_OPTIONS", ""),
            "X11_VOLUME": self.cfg.get("X11_VOLUME", ""),
            "X11_VOLUME_OPTIONS": self.cfg.get("X11_VOLUME_OPTIONS", ""),
            "X11_USE_VOLUME": self.cfg.get("X11_USE_VOLUME", "false").lower() == "true",
            "FLWM_MENU_SCRIPT": self.cfg.get("FLWM_MENU_SCRIPT", "/usr/bin/gen-flwm-menu.sh"),

            # Wayland
            "WAYLAND_COMPOSITOR": self.cfg.get("WAYLAND_COMPOSITOR", "labwc"),
            "WAYLAND_COMPOSITOR_OPTIONS": self.cfg.get("WAYLAND_COMPOSITOR_OPTIONS", ""),
            "WAYLAND_DESKTOP_NAME": self.cfg.get("WAYLAND_DESKTOP_NAME", "wlroots"),
            "WAYLAND_DESKTOP_MANAGER": self.cfg.get("WAYLAND_DESKTOP_MANAGER", "mdeon-desktop"),
            "WAYLAND_DESKTOP_MANAGER_OPTIONS": self.cfg.get("WAYLAND_DESKTOP_MANAGER_OPTIONS", ""),
            "WAYLAND_USE_DESKTOP_MANAGER": self.cfg.get("WAYLAND_USE_DESKTOP_MANAGER", "true").lower() == "true",
            "WAYLAND_DOCK_CMD": self.cfg.get("WAYLAND_DOCK_CMD", "mdeon-panel"),
            "WAYLAND_DOCK_CMD_OPTIONS": self.cfg.get("WAYLAND_DOCK_CMD_OPTIONS", ""),
            "WAYLAND_VOLUME": self.cfg.get("WAYLAND_VOLUME", ""),
            "WAYLAND_VOLUME_OPTIONS": self.cfg.get("WAYLAND_VOLUME_OPTIONS", ""),
            "WAYLAND_USE_VOLUME": self.cfg.get("WAYLAND_USE_VOLUME", "false").lower() == "true",
            "MENU_SCRIPT": self.cfg.get("MENU_SCRIPT", "/usr/bin/gen-wayland-menu.sh"),
        }
        self.modal_temp_color = self.form_values["FALLBACK_COLOR"]

        if (
            self.cmd_base(self.form_values["WAYLAND_COMPOSITOR"]) == "kwin_wayland"
            and not self.form_values["WAYLAND_COMPOSITOR_OPTIONS"].strip()
        ):
            self.form_values["WAYLAND_COMPOSITOR_OPTIONS"] = "--xwayland"

    def update_wallpaper_preview(self):
        self.wp_preview_surface = None
        if HAVE_PIL and self.wp_path and os.path.exists(self.wp_path):
            try:
                im = Image.open(self.wp_path).convert("RGBA")
                target_w, target_h = 300, 160
                im.thumbnail((target_w, target_h), Image.Resampling.BILINEAR)
                
                buf = io.BytesIO()
                im.save(buf, format="PNG")
                buf.seek(0)
                self.wp_preview_surface = cairo.ImageSurface.create_from_png(buf)
            except Exception as e:
                logger.error(f"Wallpaper preview generation error: {e}")

    def autodetect_wallpaper(self):
        def clean(path):
            if not path:
                return ""
            p = path.strip().strip("'").strip('"').replace("file://", "").strip()
            return p if (os.path.exists(p) and os.access(p, os.R_OK)) else ""

        cfg_wp = clean(self.cfg.get("WALLPAPER"))
        if cfg_wp:
            return cfg_wp

        de_vars = (
            os.environ.get("XDG_CURRENT_DESKTOP", "") + " " +
            os.environ.get("DESKTOP_SESSION", "") + " " +
            os.environ.get("MDEON_SESSION_COMPOSITOR", "")
        ).lower()

        try:
            if "cinnamon" in de_vars:
                wp = clean(subprocess.check_output(
                    "gsettings get org.cinnamon.desktop.background picture-uri",
                    shell=True, text=True, stderr=subprocess.DEVNULL
                ))
                if wp: return wp
            elif "gnome" in de_vars or "ubuntu" in de_vars:
                wp = clean(subprocess.check_output(
                    "gsettings get org.gnome.desktop.background picture-uri",
                    shell=True, text=True, stderr=subprocess.DEVNULL
                ))
                if wp: return wp
            elif "mate" in de_vars:
                wp = clean(subprocess.check_output(
                    "gsettings get org.mate.background picture-filename",
                    shell=True, text=True, stderr=subprocess.DEVNULL
                ))
                if wp: return wp
            elif "xfce" in de_vars:
                out = subprocess.check_output(
                    "xfconf-query -c xfce4-desktop -l | grep last-image",
                    shell=True, text=True, stderr=subprocess.DEVNULL
                )
                for prop in out.splitlines():
                    val = clean(subprocess.check_output(
                        f"xfconf-query -c xfce4-desktop -p {shlex.quote(prop)}",
                        shell=True, text=True, stderr=subprocess.DEVNULL
                    ))
                    if val: return val
        except Exception:
            pass

        try:
            for line in Path("/etc/lightdm/slick-greeter.conf").read_text(errors="ignore").splitlines():
                if line.strip().startswith("background="):
                    bg = clean(line.split("=", 1)[1])
                    if bg: return bg
        except Exception:
            pass

        return ""

    def apply_wallpaper(self):
        if not self.wp_path or not os.path.exists(self.wp_path):
            return
        wp = shlex.quote(self.wp_path)
        if SESSION_TYPE == "wayland":
            if has("swaybg"):
                run("killall swaybg 2>/dev/null")
                run(f"swaybg -i {wp} -m fill")
        else:
            if has("xwallpaper"):
                run(f"xwallpaper --zoom {wp}")

        try:
            uid = os.getuid()
            run(
                f"gdbus call --system "
                f"--dest org.freedesktop.Accounts "
                f"--object-path /org/freedesktop/Accounts/User{uid} "
                f"--method org.freedesktop.DBus.Properties.Set "
                f"'org.freedesktop.DisplayManager.AccountsService' "
                f"'BackgroundFile' \"<'{self.wp_path}'>\""
            )
        except Exception:
            pass

    def cmd_base(self, value):
        value = (value or "").strip()
        if not value: return ""
        try:
            parts = shlex.split(value)
            if parts: value = parts[0]
        except Exception:
            value = value.split()[0] if value.split() else value
        return os.path.basename(value).lower()

    def default_options_for_program(self, role, cmd):
        base = self.cmd_base(cmd)
        defaults = {
            ("autostart-manager", "mdeon-autostart"): "--session",
            ("x11-window-manager", "xfwm4"): "--replace",
            ("x11-desktop-manager", "mdeon-desktop"): "",
            ("x11-desktop-manager", "spacefm"): "--desktop",
            ("x11-desktop-manager", "pcmanfm"): "--desktop",
            ("wayland-dock", "waybar"): "",
            ("wayland-dock", "wf-panel-pi"): "",
            ("wayland-dock", "sfwbar"): "",
            ("wayland-dock", "yambar"): "",
            ("wayland-dock", "nwg-panel"): "",
            ("wayland-dock", "lavalauncher"): "",
            ("wayland-dock", "cairo-dock"): "",
            ("wayland-dock", "crystal-dock"): "",
            ("wayland-dock", "xfce4-panel"): "",
            ("wayland-dock", "lxqt-panel"): "",
            ("wayland-dock", "panel-session-anchor"): "",
            ("wayland-dock", "mdeon-panel"): "",
            ("x11-dock", "mdeon-panel"): "",
            ("x11-dock", "tint2"): "",
            ("x11-dock", "plank"): "",
            ("x11-dock", "polybar"): "",
            ("x11-dock", "xfce4-panel"): "",
            ("x11-dock", "lxqt-panel"): "",
            ("x11-dock", "panel-session-anchor"): "",
            ("wayland-compositor", "labwc"): "",
            ("wayland-compositor", "sway"): "",
            ("wayland-compositor", "wayfire"): "",
            ("wayland-compositor", "hyprland"): "",
            ("wayland-compositor", "hikari"): "",
            ("wayland-compositor", "weston"): "",
            ("wayland-compositor", "river"): "",
            ("wayland-compositor", "kwin_wayland"): "--xwayland",
            ("x11-compositor", "picom"): "",
            ("x11-compositor", "compton"): "",
            ("x11-compositor", "xcompmgr"): "",
            ("volume", "pasystray"): "",
            ("volume", "volumeicon"): "",
            ("volume", "pnmixer"): "",
            ("desktop-manager", "mdeon-desktop"): "",
            ("desktop-manager", "waylandminimal-desktop"): "",
            ("desktop-manager", "pcmanfm-qt"): "",
            ("desktop-manager", "nemo"): "",
            ("desktop-manager", "caja"): "",
            ("desktop-manager", "spacefm"): "",
        }
        return defaults.get((role, base), "")

    def set_program_option_pair(self, cmd_key, options_key, new_cmd, typed_options, role, reset_log):
        old_cmd = self.cfg.get(cmd_key)
        old_options = self.cfg.get(options_key)
        old_base = self.cmd_base(old_cmd)
        new_base = self.cmd_base(new_cmd)

        self.cfg.set(cmd_key, new_cmd)
        if old_base != new_base:
            safe_options = self.default_options_for_program(role, new_cmd)
            self.cfg.set(options_key, safe_options)
            self.form_values[options_key] = safe_options
            reset_log.append(
                f"{cmd_key}: {old_cmd or '<none>'} → {new_cmd or '<none>'}; "
                f"{options_key} reset to {safe_options or '<empty>'}"
            )
        else:
            self.cfg.set(options_key, typed_options)
            self.form_values[options_key] = typed_options

    def save_settings(self):
        reset_log = []

        # Common
        self.cfg.set("MDEON_NAME", self.form_values["MDEON_NAME"])
        self.cfg.set("FALLBACK_TERM", self.form_values["FALLBACK_TERM"])
        self.cfg.set("AUTOSTART_MODE", self.form_values["AUTOSTART_MODE"])
        self.set_program_option_pair(
            "AUTOSTART_MANAGER", "AUTOSTART_MANAGER_OPTIONS",
            self.form_values["AUTOSTART_MANAGER"], self.form_values["AUTOSTART_MANAGER_OPTIONS"],
            "autostart-manager", reset_log
        )
        self.cfg.set("WALLPAPER", self.wp_path or "")
        self.cfg.set("FALLBACK_COLOR", self.form_values["FALLBACK_COLOR"])
        self.set_program_option_pair(
            "VOLUME", "VOLUME_OPTIONS",
            self.form_values["VOLUME"], self.form_values["VOLUME_OPTIONS"],
            "volume", reset_log
        )
        self.cfg.set("USE_VOLUME", "true" if self.form_values["USE_VOLUME"] else "false")
        self.cfg.set("DEBUG_LOG_DIR", self.form_values["DEBUG_LOG_DIR"])
        self.cfg.set("DEBUG_LOG_MAX_FILES", self.form_values["DEBUG_LOG_MAX_FILES"])

        # X11
        self.set_program_option_pair(
            "X11_DESKTOP_MANAGER", "X11_DESKTOP_MANAGER_OPTIONS",
            self.form_values["X11_DESKTOP_MANAGER"], self.form_values["X11_DESKTOP_MANAGER_OPTIONS"],
            "x11-desktop-manager", reset_log
        )
        self.cfg.set("X11_USE_DESKTOP_MANAGER", "true" if self.form_values["X11_USE_DESKTOP_MANAGER"] else "false")
        self.set_program_option_pair(
            "WINDOW_MANAGER", "WINDOW_MANAGER_OPTIONS",
            self.form_values["WINDOW_MANAGER"], self.form_values["WINDOW_MANAGER_OPTIONS"],
            "x11-window-manager", reset_log
        )
        self.set_program_option_pair(
            "WINDOW_COMPOSITOR", "WINDOW_COMPOSITOR_OPTIONS",
            self.form_values["WINDOW_COMPOSITOR"], self.form_values["WINDOW_COMPOSITOR_OPTIONS"],
            "x11-compositor", reset_log
        )
        self.set_program_option_pair(
            "X11_DOCK_CMD", "X11_DOCK_CMD_OPTIONS",
            self.form_values["X11_DOCK_CMD"], self.form_values["X11_DOCK_CMD_OPTIONS"],
            "x11-dock", reset_log
        )
        self.set_program_option_pair(
            "X11_VOLUME", "X11_VOLUME_OPTIONS",
            self.form_values["X11_VOLUME"], self.form_values["X11_VOLUME_OPTIONS"],
            "volume", reset_log
        )
        self.cfg.set("X11_USE_VOLUME", "true" if self.form_values["X11_USE_VOLUME"] else "false")
        self.cfg.set("FLWM_MENU_SCRIPT", self.form_values["FLWM_MENU_SCRIPT"])

        # Wayland
        self.set_program_option_pair(
            "WAYLAND_COMPOSITOR", "WAYLAND_COMPOSITOR_OPTIONS",
            self.form_values["WAYLAND_COMPOSITOR"], self.form_values["WAYLAND_COMPOSITOR_OPTIONS"],
            "wayland-compositor", reset_log
        )
        self.cfg.set("WAYLAND_DESKTOP_NAME", self.form_values["WAYLAND_DESKTOP_NAME"])
        self.set_program_option_pair(
            "WAYLAND_DESKTOP_MANAGER", "WAYLAND_DESKTOP_MANAGER_OPTIONS",
            self.form_values["WAYLAND_DESKTOP_MANAGER"], self.form_values["WAYLAND_DESKTOP_MANAGER_OPTIONS"],
            "desktop-manager", reset_log
        )
        self.cfg.set("WAYLAND_USE_DESKTOP_MANAGER", "true" if self.form_values["WAYLAND_USE_DESKTOP_MANAGER"] else "false")
        self.set_program_option_pair(
            "WAYLAND_DOCK_CMD", "WAYLAND_DOCK_CMD_OPTIONS",
            self.form_values["WAYLAND_DOCK_CMD"], self.form_values["WAYLAND_DOCK_CMD_OPTIONS"],
            "wayland-dock", reset_log
        )
        self.set_program_option_pair(
            "WAYLAND_VOLUME", "WAYLAND_VOLUME_OPTIONS",
            self.form_values["WAYLAND_VOLUME"], self.form_values["WAYLAND_VOLUME_OPTIONS"],
            "volume", reset_log
        )
        self.cfg.set("WAYLAND_USE_VOLUME", "true" if self.form_values["WAYLAND_USE_VOLUME"] else "false")
        self.cfg.set("MENU_SCRIPT", self.form_values["MENU_SCRIPT"])

        self.cfg.save()
        self.apply_wallpaper()

        if reset_log:
            self.status_msg = f"Saved! Reset {len(reset_log)} options: {reset_log[0]}"
        else:
            self.status_msg = "Settings saved successfully."
        self.status_time = time.time()
        self.redraw()

    def refresh_autostart_list(self):
        files = {}
        for directory in [SYS_AUTO, USER_AUTO]:
            if not directory.exists(): continue
            for path in directory.glob("*.desktop"):
                files[path.name] = path

        self.autostart_items = []
        for name, path in sorted(files.items()):
            title = get_desktop_entry_value(path, "Name") or name.replace(".desktop", "").replace("-", " ").title()
            exec_line = shell_clean_exec(get_desktop_entry_value(path, "Exec"))
            enabled = desktop_entry_enabled(path)
            self.autostart_items.append({
                "name": name,
                "title": title,
                "exec": exec_line,
                "path": path,
                "enabled": enabled
            })

    def toggle_autostart(self, item):
        target = USER_AUTO / item["name"]
        if item["path"] != target:
            try:
                shutil.copy(item["path"], target)
            except Exception:
                return

        new_state = not item["enabled"]
        item["enabled"] = new_state
        if new_state:
            set_desktop_entry_key(target, "Hidden", "false")
            set_desktop_entry_key(target, "X-GNOME-Autostart-enabled", "true")
            set_desktop_entry_key(target, "NoDisplay", "false")
        else:
            set_desktop_entry_key(target, "Hidden", "true")
            set_desktop_entry_key(target, "X-GNOME-Autostart-enabled", "false")
        self.refresh_autostart_list()
        self.redraw()

    # ------------------------------------------------------------------
    # Cairo Drawing Helpers
    # ------------------------------------------------------------------
    def _round_rect(self, x, y, w, h, r=4):
        self.ctx.new_sub_path()
        self.ctx.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        self.ctx.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        self.ctx.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        self.ctx.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        self.ctx.close_path()

    def draw_button(self, x, y, w, h, text, callback, btn_id, primary=False):
        is_hovered = (self.hovered_id == btn_id)
        if primary:
            bg = (0.21, 0.52, 0.89) if not is_hovered else (0.28, 0.60, 0.96)
            fg = (1.0, 1.0, 1.0)
        else:
            bg = (0.22, 0.22, 0.24) if not is_hovered else (0.28, 0.28, 0.30)
            fg = (0.9, 0.9, 0.9)

        self.ctx.set_source_rgb(*bg)
        self._round_rect(x, y, w, h, 4)
        self.ctx.fill()

        self.ctx.set_source_rgb(0.35, 0.35, 0.38)
        self.ctx.set_line_width(1)
        self._round_rect(x, y, w, h, 4)
        self.ctx.stroke()

        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD if primary else cairo.FONT_WEIGHT_NORMAL)
        self.ctx.set_font_size(12)
        ext = self.ctx.text_extents(text)
        self.ctx.set_source_rgb(*fg)
        self.ctx.move_to(x + (w - ext.width) / 2, y + (h + ext.height) / 2 - 2)
        self.ctx.show_text(text)

        self.interactive_rects.append((x, y, w, h, callback, btn_id))

    def draw_entry(self, x, y, w, h, key, entry_id):
        val = str(self.form_values.get(key, ""))
        is_focused = (self.focused_entry == key)

        self.ctx.set_source_rgb(0.12, 0.12, 0.14)
        self._round_rect(x, y, w, h, 4)
        self.ctx.fill()

        self.ctx.set_source_rgb(*( (0.21, 0.52, 0.89) if is_focused else (0.25, 0.25, 0.28) ))
        self.ctx.set_line_width(1.5 if is_focused else 1)
        self._round_rect(x, y, w, h, 4)
        self.ctx.stroke()

        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        self.ctx.set_font_size(12)
        self.ctx.set_source_rgb(0.9, 0.9, 0.9)
        self.ctx.move_to(x + 8, y + h / 2 + 4)
        display_text = val if len(val) <= 45 else "..." + val[-42:]
        self.ctx.show_text(display_text)

        if is_focused and self.cursor_visible:
            ext = self.ctx.text_extents(display_text)
            cx = x + 10 + ext.width
            self.ctx.set_source_rgb(1.0, 1.0, 1.0)
            self.ctx.move_to(cx, y + 6)
            self.ctx.line_to(cx, y + h - 6)
            self.ctx.stroke()

        def on_click():
            self.focused_entry = key
            self.dropdown_popup = None
        self.interactive_rects.append((x, y, w, h, on_click, entry_id))

    def draw_dropdown(self, x, y, w, h, key, items, dropdown_id):
        val = str(self.form_values.get(key, ""))
        is_hovered = (self.hovered_id == dropdown_id)

        self.ctx.set_source_rgb(*( (0.20, 0.20, 0.22) if not is_hovered else (0.25, 0.25, 0.28) ))
        self._round_rect(x, y, w, h, 4)
        self.ctx.fill()

        self.ctx.set_source_rgb(0.3, 0.3, 0.33)
        self.ctx.set_line_width(1)
        self._round_rect(x, y, w, h, 4)
        self.ctx.stroke()

        display_text = val if val else "none"
        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        self.ctx.set_font_size(12)
        self.ctx.set_source_rgb(0.9, 0.9, 0.9)
        self.ctx.move_to(x + 10, y + h / 2 + 4)
        self.ctx.show_text(display_text)

        # Draw Down Arrow
        self.ctx.set_source_rgb(0.7, 0.7, 0.7)
        self.ctx.move_to(x + w - 18, y + h / 2 - 2)
        self.ctx.line_to(x + w - 10, y + h / 2 - 2)
        self.ctx.line_to(x + w - 14, y + h / 2 + 3)
        self.ctx.close_path()
        self.ctx.fill()

        def open_popup():
            options = list(items)
            if "none" not in options: options.append("none")
            item_h = 26
            ph = min(len(options) * item_h + 8, 220)
            py = y + h + 2 if (y + h + ph < self.height - 60) else (y - ph - 2)
            popup_x = x - self.scroll_x

            def select_item(chosen):
                self.form_values[key] = "" if chosen == "none" else chosen
                self.dropdown_popup = None
                self.redraw()

            self.dropdown_popup = (popup_x, py, w, ph, options, select_item)
            self.focused_entry = None
            self.redraw()

        self.interactive_rects.append((x, y, w, h, open_popup, dropdown_id))

    def draw_toggle(self, x, y, key, toggle_id):
        active = bool(self.form_values.get(key, False))
        w, h = 42, 22

        self.ctx.set_source_rgb(*( (0.21, 0.52, 0.89) if active else (0.25, 0.25, 0.28) ))
        self._round_rect(x, y, w, h, 11)
        self.ctx.fill()

        kx = x + w - 19 if active else x + 3
        self.ctx.set_source_rgb(1.0, 1.0, 1.0)
        self._round_rect(kx, y + 3, 16, 16, 8)
        self.ctx.fill()

        def on_toggle():
            self.form_values[key] = not self.form_values.get(key, False)
            self.redraw()

        self.interactive_rects.append((x, y, w, h, on_toggle, toggle_id))

    def open_color_selector(self):
        # Try system Zenity color picker first
        if has("zenity"):
            init_c = self.form_values.get("FALLBACK_COLOR", "#FFB6C1")
            try:
                res = subprocess.run(
                    ["zenity", "--color-selection", f"--color={init_c}", "--show-palette", "--title=Select Fallback Color"],
                    stdout=subprocess.PIPE, text=True
                )
                chosen = res.stdout.strip()
                if chosen:
                    if chosen.startswith("rgb"):
                        # Parse rgb(r,g,b)
                        nums = [int(n) for n in re.findall(r"\d+", chosen)[:3]]
                        chosen = f"#{nums[0]:02X}{nums[1]:02X}{nums[2]:02X}"
                    self.form_values["FALLBACK_COLOR"] = chosen
                    self.redraw()
                    return
            except Exception:
                pass

        # Fallback to pure Cairo built-in modal
        self.modal_temp_color = self.form_values.get("FALLBACK_COLOR", "#FFB6C1")
        self.modal_active = True
        self.redraw()

    # ------------------------------------------------------------------
    # Tab Renderers
    # ------------------------------------------------------------------
    def draw_common_tab(self, y):
        start_y = y
        # Section General
        self.ctx.set_source_rgb(0.38, 0.68, 0.93)
        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        self.ctx.set_font_size(13)
        self.ctx.move_to(30, y + 15)
        self.ctx.show_text("General")
        y += 28

        # Desktop name
        self.ctx.set_source_rgb(0.8, 0.8, 0.8)
        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        self.ctx.set_font_size(12)
        self.ctx.move_to(30, y + 18)
        self.ctx.show_text("Desktop name")
        self.draw_entry(220, y, 320, 26, "MDEON_NAME", "ent_mdeon_name")
        y += 34

        # Fallback terminal
        self.ctx.set_source_rgb(0.8, 0.8, 0.8)
        self.ctx.move_to(30, y + 18)
        self.ctx.show_text("Fallback terminal")
        self.draw_entry(220, y, 320, 26, "FALLBACK_TERM", "ent_fb_term")
        y += 34

        # Autostart mode
        self.ctx.set_source_rgb(0.8, 0.8, 0.8)
        self.ctx.move_to(30, y + 18)
        self.ctx.show_text("Autostart mode")
        self.draw_dropdown(220, y, 320, 26, "AUTOSTART_MODE", ["sequential", "parallel"], "dd_auto_mode")
        y += 34

        # Autostart manager
        self.ctx.set_source_rgb(0.8, 0.8, 0.8)
        self.ctx.move_to(30, y + 18)
        self.ctx.show_text("Autostart manager")
        self.draw_entry(220, y, 320, 26, "AUTOSTART_MANAGER", "ent_auto_mgr")
        y += 34

        # Autostart options
        self.ctx.set_source_rgb(0.8, 0.8, 0.8)
        self.ctx.move_to(30, y + 18)
        self.ctx.show_text("Autostart options")
        self.draw_entry(220, y, 320, 26, "AUTOSTART_MANAGER_OPTIONS", "ent_auto_opt")
        y += 44

        # Section Appearance
        self.ctx.set_source_rgb(0.38, 0.68, 0.93)
        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        self.ctx.set_font_size(13)
        self.ctx.move_to(30, y + 15)
        self.ctx.show_text("Appearance")
        y += 28

        # --- Wallpaper Preview Frame ---
        preview_box_w, preview_box_h = 320, 170
        self.ctx.set_source_rgb(0.10, 0.10, 0.12)
        self._round_rect(220, y, preview_box_w, preview_box_h, 6)
        self.ctx.fill()

        self.ctx.set_source_rgb(0.24, 0.24, 0.28)
        self.ctx.set_line_width(1)
        self._round_rect(220, y, preview_box_w, preview_box_h, 6)
        self.ctx.stroke()

        if self.wp_preview_surface:
            pw = self.wp_preview_surface.get_width()
            ph = self.wp_preview_surface.get_height()
            px = 220 + (preview_box_w - pw) // 2
            py = y + (preview_box_h - ph) // 2
            self.ctx.set_source_surface(self.wp_preview_surface, px, py)
            self.ctx.paint()
        else:
            self.ctx.set_source_rgb(0.5, 0.5, 0.55)
            self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
            self.ctx.set_font_size(11)
            ext = self.ctx.text_extents("No Wallpaper Preview")
            self.ctx.move_to(220 + (preview_box_w - ext.width) / 2, y + preview_box_h / 2 + 4)
            self.ctx.show_text("No Wallpaper Preview")

        y += preview_box_h + 12

        # Wallpaper selection row
        wp_label = "Wallpaper: " + (os.path.basename(self.wp_path) if self.wp_path else "None")
        self.ctx.set_source_rgb(0.8, 0.8, 0.8)
        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        self.ctx.set_font_size(12)
        self.ctx.move_to(30, y + 18)
        self.ctx.show_text(wp_label)

        def browse_wp():
            if has("zenity"):
                res = subprocess.run(["zenity", "--file-selection", "--title=Select Wallpaper"], stdout=subprocess.PIPE, text=True)
                path = res.stdout.strip()
                if path and os.path.exists(path):
                    self.wp_path = path
                    self.update_wallpaper_preview()
                    self.redraw()
        self.draw_button(220, y, 100, 26, "Browse...", browse_wp, "btn_browse_wp")
        y += 38

        # --- Fallback Color Button & Chip ---
        self.ctx.set_source_rgb(0.8, 0.8, 0.8)
        self.ctx.move_to(30, y + 18)
        self.ctx.show_text("Fallback color")

        # Color entry
        self.draw_entry(220, y, 120, 26, "FALLBACK_COLOR", "ent_fb_col")

        # Color picker button with live preview swatch
        chip_x, chip_y = 350, y
        chip_w, chip_h = 40, 26
        self.ctx.set_source_rgb_raw(*hex_to_rgb(self.form_values["FALLBACK_COLOR"]))
        self._round_rect(chip_x, chip_y, chip_w, chip_h, 4)
        self.ctx.fill()
        self.ctx.set_source_rgb(0.4, 0.4, 0.45)
        self.ctx.set_line_width(1)
        self._round_rect(chip_x, chip_y, chip_w, chip_h, 4)
        self.ctx.stroke()
        self.interactive_rects.append((chip_x, chip_y, chip_w, chip_h, self.open_color_selector, "btn_col_chip"))

        self.draw_button(400, y, 100, 26, "Pick Color", self.open_color_selector, "btn_open_picker")
        y += 48

        # Volume
        self.ctx.set_source_rgb(0.38, 0.68, 0.93)
        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        self.ctx.set_font_size(13)
        self.ctx.move_to(30, y + 15)
        self.ctx.show_text("Common Volume Fallback")
        y += 28

        self.ctx.set_source_rgb(0.8, 0.8, 0.8)
        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        self.ctx.set_font_size(12)
        self.ctx.move_to(30, y + 18)
        self.ctx.show_text("Volume Control")
        vol_items = available(["pasystray", "volumeicon", "pnmixer", "none"])
        self.draw_dropdown(220, y, 220, 26, "VOLUME", vol_items, "dd_com_vol")
        self.draw_toggle(450, y + 2, "USE_VOLUME", "tog_com_vol")
        self.draw_entry(500, y, 200, 26, "VOLUME_OPTIONS", "ent_com_vol_opt")
        y += 44

        # Diagnostics
        self.ctx.set_source_rgb(0.38, 0.68, 0.93)
        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        self.ctx.set_font_size(13)
        self.ctx.move_to(30, y + 15)
        self.ctx.show_text("Diagnostics")
        y += 28

        self.ctx.set_source_rgb(0.8, 0.8, 0.8)
        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        self.ctx.set_font_size(12)
        self.ctx.move_to(30, y + 18)
        self.ctx.show_text("Debug log dir")
        self.draw_entry(220, y, 320, 26, "DEBUG_LOG_DIR", "ent_dbg_dir")
        y += 34

        self.ctx.set_source_rgb(0.8, 0.8, 0.8)
        self.ctx.move_to(30, y + 18)
        self.ctx.show_text("Max log files")
        self.draw_entry(220, y, 100, 26, "DEBUG_LOG_MAX_FILES", "ent_dbg_max")
        y += 50
        return y - start_y

    def draw_x11_tab(self, y):
        start_y = y
        self.ctx.set_source_rgb(0.38, 0.68, 0.93)
        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        self.ctx.set_font_size(13)
        self.ctx.move_to(30, y + 15)
        self.ctx.show_text("X11 Session Programs")
        y += 28

        dm_items = available(["mdeon-desktop", "spacefm", "pcmanfm", "caja", "nemo", "none"])
        wm_items = available(["xfwm4", "openbox", "i3", "fluxbox", "icewm", "flwm", "awesome", "none"])
        comp_items = available(["picom", "compton", "xcompmgr", "none"])
        dock_items = available(["mdeon-panel", "tint2", "plank", "polybar", "xfce4-panel", "lxqt-panel", "panel-session-anchor", "none"])
        vol_items = available(["pasystray", "volumeicon", "pnmixer", "none"])

        rows = [
            ("Desktop Manager", "X11_DESKTOP_MANAGER", "X11_DESKTOP_MANAGER_OPTIONS", dm_items, "X11_USE_DESKTOP_MANAGER"),
            ("Window Manager", "WINDOW_MANAGER", "WINDOW_MANAGER_OPTIONS", wm_items, None),
            ("Compositor", "WINDOW_COMPOSITOR", "WINDOW_COMPOSITOR_OPTIONS", comp_items, None),
            ("Dock / Panel", "X11_DOCK_CMD", "X11_DOCK_CMD_OPTIONS", dock_items, None),
            ("Volume Override", "X11_VOLUME", "X11_VOLUME_OPTIONS", vol_items, "X11_USE_VOLUME"),
        ]

        for idx, (label, cmd_k, opt_k, items, toggle_k) in enumerate(rows):
            self.ctx.set_source_rgb(0.8, 0.8, 0.8)
            self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
            self.ctx.set_font_size(12)
            self.ctx.move_to(30, y + 18)
            self.ctx.show_text(label)

            self.draw_dropdown(220, y, 220, 26, cmd_k, items, f"dd_x11_{idx}")
            if toggle_k:
                self.draw_toggle(450, y + 2, toggle_k, f"tog_x11_{idx}")
                self.draw_entry(500, y, 260, 26, opt_k, f"ent_x11_opt_{idx}")
            else:
                self.draw_entry(450, y, 310, 26, opt_k, f"ent_x11_opt_{idx}")
            y += 38

        # FLWM Menu Script
        self.ctx.set_source_rgb(0.8, 0.8, 0.8)
        self.ctx.move_to(30, y + 18)
        self.ctx.show_text("FLWM menu script")
        self.draw_entry(220, y, 380, 26, "FLWM_MENU_SCRIPT", "ent_flwm_menu")
        y += 50
        return y - start_y

