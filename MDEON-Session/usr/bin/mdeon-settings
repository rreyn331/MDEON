    def draw_autostart_tab(self, y):
        start_y = y
        self.draw_entry(30, y, 400, 28, "autostart_query", "ent_as_search")
        self.draw_button(440, y, 90, 28, "Refresh", lambda: [self.refresh_autostart_list(), self.redraw()], "btn_as_refresh")
        self.draw_button(540, y, 160, 28, "Open MDEON Autostart", lambda: run("mdeon-autostart"), "btn_as_open")
        y += 40

        query = str(self.form_values.get("autostart_query", "")).lower()
        visible_items = [
            it for it in self.autostart_items
            if not query or query in it["name"].lower() or query in it["title"].lower() or query in it["exec"].lower()
        ]

        for idx, it in enumerate(visible_items):
            box_y = y
            self.ctx.set_source_rgb(0.16, 0.16, 0.18)
            self._round_rect(30, box_y, self.width - 60, 48, 6)
            self.ctx.fill()

            self.ctx.set_source_rgb(0.24, 0.24, 0.28)
            self._round_rect(30, box_y, self.width - 60, 48, 6)
            self.ctx.stroke()

            sw_x, sw_y = 45, box_y + 13
            self.ctx.set_source_rgb(*( (0.21, 0.52, 0.89) if it["enabled"] else (0.28, 0.28, 0.32) ))
            self._round_rect(sw_x, sw_y, 42, 22, 11)
            self.ctx.fill()

            kx = sw_x + 42 - 19 if it["enabled"] else sw_x + 3
            self.ctx.set_source_rgb(1.0, 1.0, 1.0)
            self._round_rect(kx, sw_y + 3, 16, 16, 8)
            self.ctx.fill()

            def make_toggle(item):
                return lambda: self.toggle_autostart(item)
            self.interactive_rects.append((sw_x, sw_y, 42, 22, make_toggle(it), f"as_tog_{idx}"))

            self.ctx.set_source_rgb(0.95, 0.95, 0.95)
            self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            self.ctx.set_font_size(12)
            self.ctx.move_to(100, box_y + 18)
            self.ctx.show_text(it["title"])

            self.ctx.set_source_rgb(0.65, 0.65, 0.68)
            self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
            self.ctx.set_font_size(11)
            self.ctx.move_to(100, box_y + 36)
            exec_text = it["exec"] if len(it["exec"]) < 90 else it["exec"][:87] + "..."
            self.ctx.show_text(exec_text)

            y += 54
        return y - start_y

    def draw_tools_tab(self, y):
        start_y = y
        tools_groups = [
            ("MDEON Tools", [
                ("MDEON Appearance", "mdeon-appearance"),
                ("MDEON Autostart Manager", "mdeon-autostart"),
                ("MDEON Autostart Dry Run", "x-terminal-emulator -e mdeon-autostart --dry-run"),
                ("Reload XDG Autostart Now", "mdeon-autostart --session"),
            ]),
            ("General Desktop Tools", [
                ("Audio Mixer — pavucontrol", "pavucontrol"),
                ("Network Manager", "nm-connection-editor"),
                ("Bluetooth Manager", "blueman-manager"),
                ("LXAppearance", "lxappearance"),
                ("Qt5 Settings", "qt5ct"),
                ("Qt6 Settings", "qt6ct"),
                ("mdeon-panel Config", "mdeon-panel-config"),
                ("Nwg Panel Config", "nwg-panel-config"),
            ]),
            ("X11 / XFWM Tools", [
                ("XFWM4 Settings", "xfwm4-settings"),
                ("XFWM4 Tweaks", "xfwm4-tweaks-settings"),
                ("XFWM4 Workspace Settings", "xfwm4-workspace-settings"),
                ("XFCE Keyboard Shortcuts", "xfce4-keyboard-settings"),
                ("XFCE Display Settings", "xfce4-display-settings"),
                ("ARandR Display Layout", "arandr"),
            ]),
            ("Wayland Tools", [
                ("Display Settings — wdisplays", "wdisplays"),
                ("Display Settings — nwg-displays", "nwg-displays"),
            ])
        ]

        for title, tools in tools_groups:
            self.ctx.set_source_rgb(0.38, 0.68, 0.93)
            self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            self.ctx.set_font_size(13)
            self.ctx.move_to(30, y + 16)
            self.ctx.show_text(title)
            y += 26

            for idx, (label, cmd) in enumerate(tools):
                col = idx % 2
                bx = 30 + col * 370
                by = y + (idx // 2) * 36
                exe = cmd.split()[0]
                if has(exe):
                    def make_tool_cb(c):
                        return lambda: run(c)
                    self.draw_button(bx, by, 350, 28, label, make_tool_cb(cmd), f"tool_{title}_{idx}")

            num_rows = math.ceil(len(tools) / 2)
            y += num_rows * 36 + 18

        return y - start_y

    def _draw_color_modal(self):
        # Backdrop
        self.ctx.set_source_rgba(0, 0, 0, 0.6)
        self.ctx.rectangle(0, 0, self.width, self.height)
        self.ctx.fill()

        mw, mh = 420, 280
        mx = (self.width - mw) // 2
        my = (self.height - mh) // 2

        self.ctx.set_source_rgb(0.18, 0.18, 0.20)
        self._round_rect(mx, my, mw, mh, 8)
        self.ctx.fill()
        self.ctx.set_source_rgb(0.35, 0.35, 0.40)
        self.ctx.set_line_width(1)
        self._round_rect(mx, my, mw, mh, 8)
        self.ctx.stroke()

        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        self.ctx.set_font_size(14)
        self.ctx.set_source_rgb(1.0, 1.0, 1.0)
        self.ctx.move_to(mx + 20, my + 30)
        self.ctx.show_text("Select Color")

        # Color Palette Swatches (6 columns x 4 rows)
        for idx, col_hex in enumerate(self.PALETTE_COLORS):
            row = idx // 6
            col = idx % 6
            bx = mx + 20 + col * 44
            by = my + 50 + row * 34

            self.ctx.set_source_rgb_raw(*hex_to_rgb(col_hex))
            self._round_rect(bx, by, 36, 26, 4)
            self.ctx.fill()

            is_cur = (self.modal_temp_color.upper() == col_hex.upper())
            self.ctx.set_source_rgb(*( (1, 1, 1) if is_cur else (0.3, 0.3, 0.35) ))
            self.ctx.set_line_width(2 if is_cur else 1)
            self._round_rect(bx, by, 36, 26, 4)
            self.ctx.stroke()

            def make_pal_cb(c):
                def cb():
                    self.modal_temp_color = c
                    self.redraw()
                return cb
            self.interactive_rects.append((bx, by, 36, 26, make_pal_cb(col_hex), f"modal_pal_{idx}"))

        # Current selection preview box
        preview_y = my + 196
        self.ctx.set_source_rgb_raw(*hex_to_rgb(self.modal_temp_color))
        self._round_rect(mx + 20, preview_y, 70, 28, 4)
        self.ctx.fill()
        self.ctx.set_source_rgb(0.4, 0.4, 0.45)
        self.ctx.set_line_width(1)
        self._round_rect(mx + 20, preview_y, 70, 28, 4)
        self.ctx.stroke()

        # Hex code label
        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        self.ctx.set_font_size(13)
        self.ctx.set_source_rgb(0.9, 0.9, 0.9)
        self.ctx.move_to(mx + 105, preview_y + 19)
        self.ctx.show_text(self.modal_temp_color)

        # Cancel & Select Buttons
        def on_cancel():
            self.modal_active = False
            self.redraw()

        def on_confirm():
            self.form_values["FALLBACK_COLOR"] = self.modal_temp_color
            self.modal_active = False
            self.redraw()

        self.draw_button(mx + mw - 190, my + mh - 44, 80, 28, "Cancel", on_cancel, "modal_cancel")
        self.draw_button(mx + mw - 100, my + mh - 44, 80, 28, "Select", on_confirm, "modal_confirm", primary=True)

    # ------------------------------------------------------------------
    # Main Render Frame
    # ------------------------------------------------------------------
    def redraw(self):
        self.interactive_rects = []

        # Background
        self.ctx.set_source_rgb(0.12, 0.12, 0.13)
        self.ctx.paint()

        # Header / Tabs Bar
        self.ctx.set_source_rgb(0.18, 0.18, 0.20)
        self.ctx.rectangle(0, 0, self.width, 46)
        self.ctx.fill()
        self.ctx.set_source_rgb(0.25, 0.25, 0.28)
        self.ctx.move_to(0, 46)
        self.ctx.line_to(self.width, 46)
        self.ctx.stroke()

        tab_gap = 10
        tab_w = min(110, (self.width - 40 - (len(self.TABS) - 1) * tab_gap) / len(self.TABS))
        tab_x = 20
        for idx, tab_name in enumerate(self.TABS):
            is_active = (self.active_tab == idx)
            self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD if is_active else cairo.FONT_WEIGHT_NORMAL)
            self.ctx.set_font_size(12)
            ext = self.ctx.text_extents(tab_name)

            if is_active:
                self.ctx.set_source_rgb(0.21, 0.52, 0.89)
                self.ctx.rectangle(tab_x, 43, tab_w, 3)
                self.ctx.fill()
                self.ctx.set_source_rgb(1.0, 1.0, 1.0)
            else:
                self.ctx.set_source_rgb(0.7, 0.7, 0.7)

            self.ctx.move_to(tab_x + (tab_w - ext.width) / 2, 28)
            self.ctx.show_text(tab_name)

            def make_tab_cb(i):
                def cb():
                    self.active_tab = i
                    self.scroll_y = 0
                    self.scroll_x = 0
                    self.focused_entry = None
                    self.dropdown_popup = None
                    self.redraw()
                return cb

            self.interactive_rects.append((tab_x, 0, tab_w, 46, make_tab_cb(idx), f"tab_{idx}"))
            tab_x += tab_w + tab_gap

        # Footer
        footer_y = self.height - 52
        self.ctx.set_source_rgb(0.15, 0.15, 0.17)
        self.ctx.rectangle(0, footer_y, self.width, 52)
        self.ctx.fill()
        self.ctx.set_source_rgb(0.24, 0.24, 0.28)
        self.ctx.move_to(0, footer_y)
        self.ctx.line_to(self.width, footer_y)
        self.ctx.stroke()

        autostart_tab_x = 20 + self.TABS.index("Autostart") * (tab_w + tab_gap)
        save_button_x = autostart_tab_x + (tab_w - 116) / 2

        # Status text
        self.ctx.set_source_rgb(0.75, 0.75, 0.78)
        self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        self.ctx.set_font_size(12)
        self.ctx.move_to(24, footer_y + 30)
        status_text = self.status_msg
        while self.ctx.text_extents(status_text).width > save_button_x - 40:
            status_text = status_text[:-4] + "..."
        self.ctx.show_text(status_text)

        # Align the fixed action button with the Autostart tab above.
        self.draw_button(save_button_x, footer_y + 11, 116, 30, "Save & Apply", lambda: self.save_settings(), "btn_save", primary=True)

        # Content Area (with Clipping)
        content_top = 60
        horizontal_track_y = footer_y - 12
        content_bottom = horizontal_track_y - 8
        content_view_width = self.width - 18
        content_view_height = content_bottom - content_top
        content_rect_start = len(self.interactive_rects)
        self.ctx.save()
        self.ctx.rectangle(0, content_top, content_view_width, content_view_height)
        self.ctx.clip()

        self.ctx.save()
        self.ctx.translate(-self.scroll_x, 0)
        content_y = content_top - self.scroll_y
        total_content_height = 0
        if self.active_tab == 0:
            total_content_height = self.draw_common_tab(content_y)
        elif self.active_tab == 1:
            total_content_height = self.draw_x11_tab(content_y)
        elif self.active_tab == 2:
            total_content_height = self.draw_wayland_tab(content_y)
        elif self.active_tab == 3:
            total_content_height = self.draw_autostart_tab(content_y)
        elif self.active_tab == 4:
            total_content_height = self.draw_tools_tab(content_y)
        self.ctx.restore()
        self.ctx.restore()

        self.max_scroll_y = max(0, total_content_height - content_view_height)
        content_widths = [700, 760, 760, self.width - 30, 750]
        content_width = content_widths[self.active_tab]
        self.max_scroll_x = max(0, content_width - content_view_width)
        clamped_scroll_y = min(self.scroll_y, self.max_scroll_y)
        clamped_scroll_x = min(self.scroll_x, self.max_scroll_x)
        if clamped_scroll_y != self.scroll_y or clamped_scroll_x != self.scroll_x:
            self.scroll_y = clamped_scroll_y
            self.scroll_x = clamped_scroll_x
            self.redraw()
            return

        # Keep hit targets aligned with the visible portion of clipped content.
        for index in range(content_rect_start, len(self.interactive_rects)):
            x, y, w, h, callback, hover_id = self.interactive_rects[index]
            visible_left = max(x - self.scroll_x, 0)
            visible_right = min(x - self.scroll_x + w, content_view_width)
            visible_top = max(y, content_top)
            visible_bottom = min(y + h, content_bottom)
            if visible_right > visible_left and visible_bottom > visible_top:
                self.interactive_rects[index] = (
                    visible_left, visible_top, visible_right - visible_left,
                    visible_bottom - visible_top, callback, hover_id
                )
            else:
                self.interactive_rects[index] = (x, 0, 0, 0, callback, hover_id)

        scrollbar_x = self.width - 12
        scrollbar_y = content_top
        scrollbar_w = 6
        scrollbar_h = content_view_height
        thumb_h = scrollbar_h
        if total_content_height > content_view_height:
            thumb_h = max(28, scrollbar_h * content_view_height / total_content_height)
            thumb_h = min(scrollbar_h, thumb_h)
        thumb_y = scrollbar_y
        if self.max_scroll_y:
            thumb_y += (scrollbar_h - thumb_h) * self.scroll_y / self.max_scroll_y
        self.scrollbar = (scrollbar_x, scrollbar_y, scrollbar_w, scrollbar_h, thumb_y, thumb_h)

        self.ctx.set_source_rgb(0.18, 0.18, 0.20)
        self._round_rect(scrollbar_x, scrollbar_y, scrollbar_w, scrollbar_h, 3)
        self.ctx.fill()
        self.ctx.set_source_rgb(0.42, 0.42, 0.46)
        self._round_rect(scrollbar_x, thumb_y, scrollbar_w, thumb_h, 3)
        self.ctx.fill()

        horizontal_track_x = 12
        horizontal_track_w = self.width - 34
        horizontal_track_h = 6
        horizontal_thumb_w = horizontal_track_w
        if content_width > content_view_width:
            horizontal_thumb_w = max(
                36, horizontal_track_w * content_view_width / content_width
            )
            horizontal_thumb_w = min(horizontal_track_w, horizontal_thumb_w)
        horizontal_thumb_x = horizontal_track_x
        if self.max_scroll_x:
            horizontal_thumb_x += (
                horizontal_track_w - horizontal_thumb_w
            ) * self.scroll_x / self.max_scroll_x
        self.horizontal_scrollbar = (
            horizontal_track_x, horizontal_track_y, horizontal_track_w,
            horizontal_track_h, horizontal_thumb_x, horizontal_thumb_w
        )
        self.ctx.set_source_rgb(0.18, 0.18, 0.20)
        self._round_rect(horizontal_track_x, horizontal_track_y, horizontal_track_w, horizontal_track_h, 3)
        self.ctx.fill()
        self.ctx.set_source_rgb(0.42, 0.42, 0.46)
        self._round_rect(horizontal_thumb_x, horizontal_track_y, horizontal_thumb_w, horizontal_track_h, 3)
        self.ctx.fill()

        # Dropdown Popup Overlay
        if self.dropdown_popup:
            px, py, pw, ph, items, callback = self.dropdown_popup
            self.ctx.set_source_rgb(0.18, 0.18, 0.20)
            self._round_rect(px, py, pw, ph, 4)
            self.ctx.fill()
            self.ctx.set_source_rgb(0.35, 0.35, 0.38)
            self._round_rect(px, py, pw, ph, 4)
            self.ctx.stroke()

            item_h = 26
            for idx, item in enumerate(items):
                iy = py + 4 + idx * item_h
                if iy + item_h > py + ph:
                    break
                is_item_hov = (self.hovered_id == f"pop_item_{idx}")
                if is_item_hov:
                    self.ctx.set_source_rgb(0.21, 0.52, 0.89)
                    self._round_rect(px + 2, iy, pw - 4, item_h, 3)
                    self.ctx.fill()
                    self.ctx.set_source_rgb(1.0, 1.0, 1.0)
                else:
                    self.ctx.set_source_rgb(0.85, 0.85, 0.85)

                self.ctx.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
                self.ctx.set_font_size(12)
                self.ctx.move_to(px + 10, iy + item_h / 2 + 4)
                self.ctx.show_text(item)

                def make_choice_cb(choice):
                    return lambda: callback(choice)
                self.interactive_rects.append((px + 2, iy, pw - 4, item_h, make_choice_cb(item), f"pop_item_{idx}"))

        # Color Modal Overlay
        if self.modal_active:
            self._draw_color_modal()

        self.surface.flush()
        self.flush_cb()

    # ------------------------------------------------------------------
    # User Input & Event Handlers
    # ------------------------------------------------------------------
    def handle_click(self, x, y, button):
        if button == 1:
            if self.scrollbar:
                sx, sy, sw, sh, thumb_y, thumb_h = self.scrollbar
                if sx <= x <= sx + sw and sy <= y <= sy + sh and self.max_scroll_y:
                    if thumb_y <= y <= thumb_y + thumb_h:
                        self.scrollbar_dragging = True
                        self.scrollbar_drag_offset = y - thumb_y
                    else:
                        self.scrollbar_drag_offset = thumb_h / 2
                        self._scroll_to_thumb(y)
                    return
            if self.horizontal_scrollbar:
                sx, sy, sw, sh, thumb_x, thumb_w = self.horizontal_scrollbar
                if sx <= x <= sx + sw and sy <= y <= sy + sh and self.max_scroll_x:
                    if thumb_x <= x <= thumb_x + thumb_w:
                        self.horizontal_scrollbar_dragging = True
                        self.horizontal_scrollbar_drag_offset = x - thumb_x
                    else:
                        self.horizontal_scrollbar_drag_offset = thumb_w / 2
                        self._scroll_to_horizontal_thumb(x)
                    return
            for rx, ry, rw, rh, cb, _ in reversed(self.interactive_rects):
                if rx <= x <= rx + rw and ry <= y <= ry + rh:
                    cb()
                    return
            if self.dropdown_popup:
                self.dropdown_popup = None
                self.redraw()
            self.focused_entry = None
            self.redraw()
        elif button == 4:  # Scroll Up
            self.scroll_y = max(0, self.scroll_y - 36)
            self.redraw()
        elif button == 5:  # Scroll Down
            self.scroll_y = min(self.max_scroll_y, self.scroll_y + 36)
            self.redraw()

    def handle_motion(self, x, y):
        if self.scrollbar_dragging:
            self._scroll_to_thumb(y)
            return
        if self.horizontal_scrollbar_dragging:
            self._scroll_to_horizontal_thumb(x)
            return
        prev_hover = self.hovered_id
        self.hovered_id = None
        for rx, ry, rw, rh, _, hid in self.interactive_rects:
            if rx <= x <= rx + rw and ry <= y <= ry + rh:
                self.hovered_id = hid
                break
        if prev_hover != self.hovered_id:
            self.redraw()

    def handle_button_release(self, button):
        if button == 1:
            self.scrollbar_dragging = False
            self.horizontal_scrollbar_dragging = False

    def _scroll_to_thumb(self, pointer_y):
        if not self.scrollbar or not self.max_scroll_y:
            return
        _, track_y, _, track_h, _, thumb_h = self.scrollbar
        travel = track_h - thumb_h
        if travel <= 0:
            return
        thumb_top = min(max(pointer_y - self.scrollbar_drag_offset, track_y), track_y + travel)
        self.scroll_y = round((thumb_top - track_y) / travel * self.max_scroll_y)
        self.redraw()

    def _scroll_to_horizontal_thumb(self, pointer_x):
        if not self.horizontal_scrollbar or not self.max_scroll_x:
            return
        track_x, _, track_w, _, _, thumb_w = self.horizontal_scrollbar
        travel = track_w - thumb_w
        if travel <= 0:
            return
        thumb_left = min(
            max(pointer_x - self.horizontal_scrollbar_drag_offset, track_x),
            track_x + travel
        )
        self.scroll_x = round((thumb_left - track_x) / travel * self.max_scroll_x)
        self.redraw()

    def handle_key(self, keysym, string_val=""):
        if not self.focused_entry:
            return

        curr = str(self.form_values.get(self.focused_entry, ""))
        if keysym == 0xff08:  # Backspace
            if curr:
                self.form_values[self.focused_entry] = curr[:-1]
                self.redraw()
        elif keysym in (0xff0d, 0xff1b):  # Enter or Escape
            self.focused_entry = None
            self.redraw()
        else:
            if string_val and string_val.isprintable():
                self.form_values[self.focused_entry] = curr + string_val
                self.redraw()


# ----------------------------------------------------------------------
# X11 Window Runner
# ----------------------------------------------------------------------
def run_x11():
    if not HAVE_X11:
        raise RuntimeError("libX11 not found on system.")

    logger.info("Starting MDEON Settings in X11 Mode...")
    display = x11.XOpenDisplay(None)
    if not display:
        raise RuntimeError("Unable to open X11 Display.")

    screen = x11.XDefaultScreen(display)
    root = x11.XRootWindow(display, screen)
    visual = x11.XDefaultVisual(display, screen)
    depth = x11.XDefaultDepth(display, screen)

    screen_width = x11.XDisplayWidth(display, screen)
    screen_height = x11.XDisplayHeight(display, screen)
    width = max(520, min(780, screen_width - 40))
    height = max(300, min(600, screen_height - 70))
    win = x11.XCreateSimpleWindow(display, root, 20, 20, width, height, 0, 0, 0x1e1e1e)
    gc = x11.XCreateGC(display, win, 0, None)

    # Window Titles & Properties
    x11.XStoreName(display, win, b"MDEON Settings")
    atom_class = x11.XInternAtom(display, b"WM_CLASS", 0)
    x11.XChangeProperty(display, win, atom_class, 31, 8, 0, b"mdeon-settings\0mdeon-settings\0", 30)

    atom_type = x11.XInternAtom(display, b"_NET_WM_WINDOW_TYPE", 0)
    atom_normal = x11.XInternAtom(display, b"_NET_WM_WINDOW_TYPE_NORMAL", 0)
    x11.XChangeProperty(display, win, atom_type, 4, 32, 0, (ctypes.c_ulong * 1)(atom_normal), 1)

    # Intercept WM_DELETE_WINDOW protocol
    atom_protocols = x11.XInternAtom(display, b"WM_PROTOCOLS", 0)
    atom_delete = x11.XInternAtom(display, b"WM_DELETE_WINDOW", 0)
    x11.XChangeProperty(display, win, atom_protocols, 4, 32, 0, (ctypes.c_ulong * 1)(atom_delete), 1)

    # Listen to inputs: Exposure, KeyPress, ButtonPress, PointerMotion, StructureNotify
    x11.XSelectInput(display, win, (1 << 0) | (1 << 15) | (1 << 2) | (1 << 3) | (1 << 6) | (1 << 13) | (1 << 17))
    x11.XMapWindow(display, win)
    x11.XFlush(display)

    app = None
    def flush():
        x11.XPutImage(display, win, gc, app.ximage, 0, 0, 0, 0, width, height)
        x11.XFlush(display)

    app = MdeonSettingsCairo(width, height, flush)
    c_data = (ctypes.c_char * (app.stride * height)).from_buffer(app.data_buffer)
    app.ximage = x11.XCreateImage(display, visual, depth, 2, 0, ctypes.addressof(c_data), width, height, 32, app.stride)

    def replace_backing_image(new_width, new_height):
        nonlocal width, height, c_data
        min_width, min_height = 520, 300
        new_width = max(min_width, new_width)
        new_height = max(min_height, new_height)
        if (new_width, new_height) == (width, height):
            return

        if new_width != width or new_height != height:
            image_data = ctypes.cast(app.ximage, ctypes.POINTER(XImageData)).contents
            destroy_image = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p)(image_data.funcs.destroy_image)
            image_data.data = None
            destroy_image(app.ximage)

        width, height = new_width, new_height
        app.width, app.height = width, height
        app._init_cairo()
        c_data = (ctypes.c_char * (app.stride * height)).from_buffer(app.data_buffer)
        app.ximage = x11.XCreateImage(
            display, visual, depth, 2, 0, ctypes.addressof(c_data), width, height, 32, app.stride
        )
        app.redraw()

    app.redraw()
    ev = XEvent()

    running = True
    while running:
        while x11.XPending(display):
            x11.XNextEvent(display, ctypes.byref(ev))
            if ev.type == 12:  # Expose
                app.redraw()
            elif ev.type == 6:  # MotionNotify
                mev = ctypes.cast(ctypes.byref(ev), ctypes.POINTER(XMotionEvent)).contents
                app.handle_motion(mev.x, mev.y)
            elif ev.type == 4:  # ButtonPress
                bev = ctypes.cast(ctypes.byref(ev), ctypes.POINTER(XButtonEvent)).contents
                app.handle_click(bev.x, bev.y, bev.button)
            elif ev.type == 5:  # ButtonRelease
                bev = ctypes.cast(ctypes.byref(ev), ctypes.POINTER(XButtonEvent)).contents
                app.handle_button_release(bev.button)
            elif ev.type == 22:  # ConfigureNotify
                cev = ctypes.cast(ctypes.byref(ev), ctypes.POINTER(XConfigureEvent)).contents
                if cev.width < 520 or cev.height < 300:
                    x11.XResizeWindow(display, win, max(520, cev.width), max(300, cev.height))
                    x11.XFlush(display)
                else:
                    replace_backing_image(cev.width, cev.height)
            elif ev.type == 2:  # KeyPress
                kev = ctypes.cast(ctypes.byref(ev), ctypes.POINTER(XKeyEvent)).contents
                keysym = x11.XKeycodeToKeysym(display, kev.keycode, 0)
                str_buf = ctypes.create_string_buffer(32)
                n = x11.XLookupString(ctypes.byref(kev), str_buf, 32, None, None)
                text_val = str_buf.value.decode("utf-8", "ignore") if n > 0 else ""
                app.handle_key(keysym, text_val)
            elif ev.type == 33:  # ClientMessage (Close Window event)
                cmev = ctypes.cast(ctypes.byref(ev), ctypes.POINTER(XClientMessageEvent)).contents
                if cmev.message_type == atom_protocols and cmev.data[0] == atom_delete:
                    running = False
                    break
        time.sleep(0.015)

    x11.XDestroyWindow(display, win)
    x11.XCloseDisplay(display)


# ----------------------------------------------------------------------
# Application Entrypoint
# ----------------------------------------------------------------------
if __name__ == "__main__":
    try:
        if SESSION_TYPE == "wayland" and os.environ.get("WAYLAND_DISPLAY"):
            logger.info("Starting MDEON Settings in Wayland Mode...")
            try:
                run_cairo_gtk(MdeonSettingsCairo, "MDEON Settings", 780, 600, 520, 300)
            except Exception as e:
                if not os.environ.get("DISPLAY"):
                    raise
                logger.warning("Wayland window startup failed (%s); falling back to X11.", e)
                run_x11()
        elif os.environ.get("DISPLAY"):
            run_x11()
        else:
            raise RuntimeError("No graphical display available (Wayland or X11).")
    except KeyboardInterrupt:
        logger.info("MDEON Settings cleanly terminated.")
    except Exception as e:
        logger.error(f"Execution failed: {e}")
