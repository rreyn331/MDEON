    from PIL import Image
    HAVE_PIL = True
except ImportError:
    HAVE_PIL = False

# ----------------------------------------------------------------------
# Process Identification
# ----------------------------------------------------------------------
def identify_process(name="mdeon-settings"):
    name = Path(__file__).name
    sys.argv[0] = name
    if sys.platform.startswith("linux"):
        try:
            libc = ctypes.CDLL("libc.so.6")
            libc.prctl(15, name.encode("utf-8"), 0, 0, 0)
        except Exception:
            pass
    try:
        import setproctitle
        setproctitle.setproctitle(name)
    except ImportError:
        pass

identify_process()

# ----------------------------------------------------------------------
# Paths and Defaults
# ----------------------------------------------------------------------
CONF = Path.home() / ".config/mdeon/mdeon.conf"
DFLT = Path("/etc/mdeon/mdeon.conf.default")
USER_AUTO = Path.home() / ".config/autostart"
SYS_AUTO = Path("/etc/xdg/autostart")
USER_AUTO.mkdir(parents=True, exist_ok=True)

SESSION_TYPE = os.environ.get(
    "XDG_SESSION_TYPE", "wayland" if os.environ.get("WAYLAND_DISPLAY") else "x11"
).lower()

logging.basicConfig(
    level=logging.DEBUG if os.environ.get("MDEON_DEBUG") == "1" else logging.INFO,
    format="[MDEON-SETTINGS] %(levelname)s: %(message)s",
)
logger = logging.getLogger("mdeon-settings")

