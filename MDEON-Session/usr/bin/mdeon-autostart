        ly = my + 76
        self.modal_select_rects = []
        for i, item in enumerate(self.modal_items[:6]):
            cr.set_source_rgb(*(self.c_accent if i == self.modal_selected else (0.22, 0.22, 0.25)))
            cr.rectangle(mx + 20, ly, mw - 40, 26)
