            (bx + 90, by, 80, 28, lambda: self._submit_select_modal())
        ]

    # ------------------------------------------------------------------
    # User Input & Event Dispatchers
    # ------------------------------------------------------------------
    def handle_click(self, x, y, button):
        # 1. Modals Capture
        if self.modal_type is not None:
            # Check button actions
            for bx, by, bw, bh, cb in getattr(self, "modal_btn_rects", []):
                if bx <= x <= bx + bw and by <= y <= by + bh:
                    cb()
                    return

            if self.modal_type == "EDIT":
                for item in getattr(self, "edit_field_rects", []):
                    key, fx, fy, fw, fh = item
                    if fx <= x <= fx + fw and fy <= y <= fy + fh:
                        if key == "enabled_switch":
                            curr = self.modal_fields.get("enabled", False)
                            new_val = not curr
                            self.modal_fields["enabled"] = new_val
                            try:
                                set_file_enabled(self.modal_fields["filename"], new_val)
                            except Exception as e:
                                logger.error("Failed to toggle immediate switch: %s", e)
                            self.redraw()
                            return
                        elif key.startswith("phase:"):
                            self.modal_fields["phase"] = key.split(":", 1)[1]
                            self.redraw()
                            return
                        else:
                            self.modal_focus_field = key
                            self.redraw()
                            return

            elif self.modal_type == "SELECT":
                for i, sx, sy, sw, sh in getattr(self, "modal_select_rects", []):
                    if sx <= x <= sx + sw and sy <= y <= sy + sh:
                        self.modal_selected = i
                        self.redraw()
                        return
            return

        # 2. Main Page Navigation
        if self.page == "MAIN":
            for bx, by, bw, bh, cb in getattr(self, "main_btn_rects", []):
                if bx <= x <= bx + bw and by <= y <= by + bh:
                    cb()
                    return
            return

        # 3. Manage Page Actions
        if self.page == "MANAGE":
            # Manage Bottom buttons
            for bx, by, bw, bh, cb in getattr(self, "manage_btn_rects", []):
                if bx <= x <= bx + bw and by <= y <= by + bh:
                    cb()
                    return

            # Scrollbar drag
            sb_x, sb_y, sb_w, sb_h, thumb_y, thumb_h, max_scroll = getattr(self, "scrollbar_rect", (0, 0, 0, 0, 0, 0, 0))
            if sb_x <= x <= sb_x + sb_w and sb_y <= y <= sb_y + sb_h:
                if thumb_y <= y <= thumb_y + thumb_h:
                    self.is_dragging_scrollbar = True
                    self.drag_start_y = y
                    self.drag_start_offset = self.scroll_offset
                else:
                    ratio = (y - sb_y) / sb_h
                    self.scroll_offset = max(0, min(max_scroll, int(ratio * max_scroll)))
                    self.redraw()
                return

            # Manage Entry Rows
            for idx, ry, sw_x, sw_y, sw_w, sw_h, be_x, be_y, be_w, be_h, it in getattr(self, "manage_row_rects", []):
                # Row selection
                if 24 <= x <= self.width - 48 and ry <= y <= ry + self.row_height:
                    self.selected_idx = idx
                    # Direct Switch Click
                    if sw_x <= x <= sw_x + sw_w and sw_y <= y <= sw_y + sw_h:
                        self._toggle_entry(it["base"])
                        return
                    # Open / Edit Click
                    if be_x <= x <= be_x + be_w and be_y <= y <= be_y + be_h:
                        self._open_edit_entry(it["base"])
                        return
                    self.redraw()
                    return

    def handle_motion(self, x, y):
        if self.is_dragging_scrollbar and self.page == "MANAGE":
            sb_x, sb_y, sb_w, sb_h, _, thumb_h, max_scroll = getattr(self, "scrollbar_rect", (0, 0, 0, 0, 0, 0, 0))
            dy = y - self.drag_start_y
            track_avail = max(1, sb_h - thumb_h)
            scroll_delta = int((dy / track_avail) * max_scroll)
            self.scroll_offset = max(0, min(max_scroll, self.drag_start_offset + scroll_delta))
            self.redraw()

    def handle_button_release(self, button):
        if button == 1:
            self.is_dragging_scrollbar = False

    def handle_scroll(self, dy):
        if self.modal_type == "TEXT":
            self.modal_scroll = max(0, self.modal_scroll + dy * 2)
            self.redraw()
            return
        if self.page == "MANAGE":
            self.scroll_offset = max(0, min(len(self.entries) - 3, self.scroll_offset + dy))
            self.redraw()

    def handle_key(self, keysym, string_val=""):
        # Modal Typing Handling
        if self.modal_type == "INPUT":
            val = self.modal_fields.get("input_val", "")
            if keysym in (0xff08, 0xffff):  # Backspace / Delete
                self.modal_fields["input_val"] = val[:-1]
                self.redraw()
            elif keysym in (0xff0d, 0xff8d):  # Enter
                self._submit_input_modal(val)
            elif keysym == 0xff1b:  # Escape
                self._close_modal()
            elif string_val and string_val.isprintable():
                self.modal_fields["input_val"] = val + string_val
                self.redraw()
            elif 32 <= keysym <= 126:
                self.modal_fields["input_val"] = val + chr(keysym)
                self.redraw()
            return

        if self.modal_type == "EDIT" and self.modal_focus_field:
            val = str(self.modal_fields.get(self.modal_focus_field, ""))
            if keysym in (0xff08, 0xffff):  # Backspace
                self.modal_fields[self.modal_focus_field] = val[:-1]
                self.redraw()
            elif keysym in (0xff0d, 0xff8d):  # Enter
                self.modal_focus_field = None
                self.redraw()
            elif keysym == 0xff1b:
                self.modal_focus_field = None
                self.redraw()
            elif string_val and string_val.isprintable():
                self.modal_fields[self.modal_focus_field] = val + string_val
                self.redraw()
            elif 32 <= keysym <= 126:
                self.modal_fields[self.modal_focus_field] = val + chr(keysym)
                self.redraw()
            return

        # General Keys
        if keysym == 0xff1b:  # Escape
            if self.modal_type:
                self._close_modal()
            elif self.page == "MANAGE":
                self._nav_main()
            return

        if self.page == "MANAGE":
            if keysym in (0xff54, 0x6a):  # Down
                if self.selected_idx < len(self.entries) - 1:
                    self.selected_idx += 1
                    if self.selected_idx - self.scroll_offset > (self.height - 180) // self.row_height:
                        self.scroll_offset += 1
                    self.redraw()
            elif keysym in (0xff52, 0x6b):  # Up
                if self.selected_idx > 0:
                    self.selected_idx -= 1
                    if self.selected_idx < self.scroll_offset:
                        self.scroll_offset = self.selected_idx
                    self.redraw()
            elif keysym == 0x20:  # Space
                self._action_toggle_selected()
            elif keysym in (0xff0d, 0xff8d):  # Enter
                self._action_edit_selected()

    # ------------------------------------------------------------------
    # Action Handlers Matching GTK Specification
    # ------------------------------------------------------------------
    def selected_base(self):
        if 0 <= self.selected_idx < len(self.entries):
            return self.entries[self.selected_idx]["base"]
        return None

    def _nav_manage(self):
        self.page = "MANAGE"
        self.redraw()
        self.refresh()

    def _nav_main(self):
        self.page = "MAIN"
        self.redraw()

    def _toggle_mode(self):
        global USE_PARALLEL
        USE_PARALLEL = not USE_PARALLEL
        self.redraw()

    def _action_toggle_selected(self):
        base = self.selected_base()
        if not base:
            self._show_info("No Selection", "Select an entry first.")
            return
        self._toggle_entry(base)

    def _toggle_entry(self, base):
        for it in self.entries:
            if it["base"] == base:
                try:
                    set_entry_enabled_by_base(base, not it["enabled"])
                except Exception as e:
                    logger.error("Failed to toggle entry: %s", e)
                self.refresh(select_base=base)
                break

    def _action_edit_selected(self):
        base = self.selected_base()
        if not base:
            self._show_info("No Selection", "Select an entry first.")
            return
        self._open_edit_entry(base)

    def _open_edit_entry(self, base):
        filename = ENTRY_FILE.get(base)
        if not filename:
            self._show_info("Missing Entry", f"Entry no longer exists:\n\n{base}")
            return
        try:
            filename = ensure_user_file(filename)
        except Exception as e:
            self._show_info("Error", f"Could not create user override for:\n\n{base}\n\n{e}")
            return

        df = DesktopFile(filename)
        self.modal_type = "EDIT"
        self.modal_title = f"View / Edit Entry - {base}"
        self.modal_fields = {
            "base": base,
            "filename": filename,
            "enabled": df.enabled(),
            "name": df.get("Name", ""),
            "exec": strip_quotes(df.get("Exec", "")),
            "tryexec": df.get("TryExec", ""),
            "onlyshow": df.get("OnlyShowIn", ""),
            "notshow": df.get("NotShowIn", ""),
            "delay": df.get("X-GNOME-Autostart-Delay", "0") or "0",
            "phase": df.get("X-GNOME-Autostart-Phase", "Application") or "Application",
        }
        self.modal_focus_field = None
        self.redraw()

    def _save_edit_modal(self):
        fn = self.modal_fields["filename"]
        df = DesktopFile(fn)
        name_val = sanitize_desktop_value(self.modal_fields["name"])
        exec_val = sanitize_desktop_value(self.modal_fields["exec"])

        if not name_val:
            self._show_info("Invalid Entry", "Name cannot be empty.")
            return
        if not exec_val:
            self._show_info("Invalid Entry", "Exec cannot be empty.")
            return

        args, _, err = split_exec_command(exec_val)
        if err or not args:
            self._show_info("Invalid Exec", f"Exec line is invalid:\n\n{err}")
            return

        df.set_enabled(self.modal_fields["enabled"])
        df.set("Name", name_val)
        df.set("Exec", exec_val)

        for k, desktop_key in [
            ("tryexec", "TryExec"), ("onlyshow", "OnlyShowIn"), ("notshow", "NotShowIn")
        ]:
            val = sanitize_desktop_value(self.modal_fields.get(k, ""))
            if val:
                df.set(desktop_key, val)
            else:
                df.delete(desktop_key)

        df.set("X-GNOME-Autostart-Phase", self.modal_fields.get("phase", "Application"))
        df.set("X-GNOME-Autostart-Delay", format_delay(self.modal_fields.get("delay", "0")))

        try:
            df.save()
        except Exception as e:
            self._show_info("Save Failed", str(e))
            return

        self._close_modal()
        self.refresh(select_base=self.modal_fields["base"])

    def _prompt_add_entry(self):
        def on_name_entered(name):
            if not name:
                return
            def on_cmd_entered(cmd):
                if not cmd:
                    return
                parsed, _, err = split_exec_command(cmd)
                if err or not parsed:
                    self._show_info("Invalid Command", f"Command is invalid:\n\n{err}")
                    return

                fn = os.path.join(USER_DIR, sanitize_filename(name))
                df = DesktopFile(fn)
                df.lines = [
                    "[Desktop Entry]\n",
                    "Type=Application\n",
                    f"Name={name}\n",
                    f"Exec={cmd}\n",
                    "Hidden=false\n",
                    "X-GNOME-Autostart-enabled=true\n",
                    "X-GNOME-Autostart-Phase=Application\n",
                    "X-GNOME-Autostart-Delay=0\n",
                ]
                try:
                    df.save()
                    self._show_info("Entry Added", f"Created:\n{fn}")
                except Exception as e:
                    self._show_info("Create Failed", str(e))

            self._prompt_input("Add New Entry", "Command:", on_cmd_entered)

        self._prompt_input("Add New Entry", "Name:", on_name_entered)

    def _prompt_delete_entry(self):
        collect_entries()
        user_entries = sorted(
            b for b, fn in ENTRY_FILE.items() if is_inside_dir(fn, USER_DIR)
        )
        if not user_entries:
            self._show_info("Delete User Entry", "No user entries exist.")
            return

        def on_selected(entry_name):
            fn = os.path.join(USER_DIR, os.path.basename(entry_name))
            try:
                os.remove(fn)
                self._show_info("Deleted", f"Deleted:\n{fn}")
                self.refresh()
            except OSError as e:
                self._show_info("Error", f"Could not delete:\n{fn}\n\n{e}")

        self.modal_type = "SELECT"
        self.modal_title = "Delete User Entry"
        self.modal_text = "Choose a user autostart entry to delete:"
        self.modal_items = user_entries
        self.modal_selected = 0
        self.modal_cb = on_selected
        self.redraw()

    def _action_execute_session(self):
        execute_entries()
        mode = "PARALLEL" if USE_PARALLEL else "SEQUENTIAL"
        self._show_info("Session Started", f"Session started in {mode} mode.\n\nLog:\n{LOG_FILE}")

    def _action_dry_run(self):
        global DRY_RUN
        DRY_RUN = True
        output = execute_entries()
        DRY_RUN = False
        if not output.strip():
            output = "No programs would be started."
        self._show_info("Dry Run View (Phase breakdown)", output)

    def _action_show_manual(self):
        help_text = """MDEON AUTOSTART MANAGER - HELP
==============================

COMMAND LINE OPTIONS:
  --session            Start enabled apps sequentially
  --session-parallel   Start enabled apps in parallel
  --dry-run            Show what would start without launching anything
  --list               List entries
  --enable FILE        Enable an entry
  --disable FILE       Disable an entry
  --delete FILE        Delete a user entry

SYMBOLS:
  [+]  Enabled at login
  [-]  Disabled at login
  ●    Currently running
  ○    Currently idle

POLKIT PROTECTION:
  Before normal applications are started, this tool ensures that one Polkit
  authentication agent is running.
  It uses a lock file:
    ~/.local/share/mdeon-autostart/polkit-start.lock

MANAGE ENTRIES PAGE:
  Switch ON = enabled at login. Switch OFF = disabled.
  Open / Edit:
    The "Enabled at login" switch applies immediately.
    Other fields are saved only when Save is pressed.

STARTUP PHASES:
  Entries launch in this order:
    Initialization -> WindowManager -> Panel -> Desktop -> Application
"""
        self._show_info("Manual / Help", help_text)

    def _prompt_input(self, title, label, cb):
        self.modal_type = "INPUT"
        self.modal_title = title
        self.modal_text = label
        self.modal_fields = {"input_val": ""}
        self.modal_cb = cb
        self.redraw()

    def _submit_input_modal(self, val):
        cb = self.modal_cb
        self._close_modal()
        if cb:
            cb(val)

    def _submit_select_modal(self):
        if 0 <= self.modal_selected < len(self.modal_items):
            item = self.modal_items[self.modal_selected]
            cb = self.modal_cb
            self._close_modal()
            if cb:
                cb(item)

    def _show_info(self, title, text):
        self.modal_type = "TEXT"
        self.modal_title = title
        self.modal_text = text
        self.modal_scroll = 0
        self.redraw()

    def _close_modal(self):
        self.modal_type = None
        self.modal_focus_field = None
        self.redraw()

# ----------------------------------------------------------------------
# Direct X11 Backend
# ----------------------------------------------------------------------
def run_x11():
    try:
        x11 = ctypes.cdll.LoadLibrary("libX11.so.6")
    except OSError:
        raise RuntimeError("libX11.so.6 is required for X11 mode.")

    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XDefaultScreen.restype = ctypes.c_int
    x11.XDefaultScreen.argtypes = [ctypes.c_void_p]
    x11.XRootWindow.restype = ctypes.c_ulong
    x11.XRootWindow.argtypes = [ctypes.c_void_p, ctypes.c_int]
    x11.XDefaultVisual.restype = ctypes.c_void_p
    x11.XDefaultVisual.argtypes = [ctypes.c_void_p, ctypes.c_int]
    x11.XDefaultDepth.restype = ctypes.c_int
    x11.XDefaultDepth.argtypes = [ctypes.c_void_p, ctypes.c_int]
    x11.XCreateSimpleWindow.restype = ctypes.c_ulong
    x11.XCreateSimpleWindow.argtypes = [
        ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int,
        ctypes.c_uint, ctypes.c_uint, ctypes.c_uint, ctypes.c_ulong, ctypes.c_ulong
    ]
    x11.XCreateGC.restype = ctypes.c_void_p
    x11.XCreateGC.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_void_p]
    x11.XCreateImage.restype = ctypes.c_void_p
    x11.XCreateImage.argtypes = [
        ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint, ctypes.c_int,
        ctypes.c_int, ctypes.c_void_p, ctypes.c_uint, ctypes.c_uint,
        ctypes.c_int, ctypes.c_int
    ]
    x11.XPutImage.restype = ctypes.c_int
    x11.XPutImage.argtypes = [
        ctypes.c_void_p, ctypes.c_ulong, ctypes.c_void_p, ctypes.c_void_p,
        ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int,
        ctypes.c_uint, ctypes.c_uint
    ]
    x11.XSelectInput.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_long]
    x11.XMapWindow.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    x11.XFlush.argtypes = [ctypes.c_void_p]
    x11.XPending.restype = ctypes.c_int
    x11.XPending.argtypes = [ctypes.c_void_p]
    x11.XKeycodeToKeysym.restype = ctypes.c_ulong
    x11.XKeycodeToKeysym.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int]
    x11.XStoreName.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_char_p]

    display = x11.XOpenDisplay(None)
    if not display:
        raise RuntimeError("Cannot open X11 display.")

    screen = x11.XDefaultScreen(display)
    root = x11.XRootWindow(display, screen)
    width, height = 860, 580

    win = x11.XCreateSimpleWindow(display, root, 100, 100, width, height, 0, 0, 0x1e1e1e)
    x11.XStoreName(display, win, b"MDEON Autostart Manager")

    # Select KeyPress (1<<0), ButtonPress (1<<2), ButtonRelease (1<<3), PointerMotion (1<<6), Exposure (1<<15)
    x11.XSelectInput(display, win, (1 << 0) | (1 << 2) | (1 << 3) | (1 << 6) | (1 << 15))
    x11.XMapWindow(display, win)
    x11.XFlush(display)

    gc = x11.XCreateGC(display, win, 0, None)
    visual = x11.XDefaultVisual(display, screen)
    depth = x11.XDefaultDepth(display, screen)

    manager = None
    def flush():
        if manager is not None and getattr(manager, "ximage", None):
            x11.XPutImage(display, win, gc, manager.ximage, 0, 0, 0, 0, width, height)
            x11.XFlush(display)

    manager = CairoAutostartManager(width, height, flush)
    c_data = (ctypes.c_char * (manager.stride * height)).from_buffer(manager.data_buffer)
    manager.ximage = x11.XCreateImage(
        display, visual, depth, 2, 0, ctypes.addressof(c_data), width, height, 32, manager.stride
    )
    manager.redraw()

    class XEvent(ctypes.Structure):
        _fields_ = [("type", ctypes.c_int), ("pad", ctypes.c_byte * 192)]

    class XButtonEvent(ctypes.Structure):
        _fields_ = [
            ("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
            ("display", ctypes.c_void_p), ("window", ctypes.c_ulong), ("root", ctypes.c_ulong),
            ("subwindow", ctypes.c_ulong), ("time", ctypes.c_ulong),
            ("x", ctypes.c_int), ("y", ctypes.c_int), ("x_root", ctypes.c_int), ("y_root", ctypes.c_int),
            ("state", ctypes.c_uint), ("button", ctypes.c_uint), ("same_screen", ctypes.c_int),
        ]

    class XMotionEvent(ctypes.Structure):
        _fields_ = [
            ("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
            ("display", ctypes.c_void_p), ("window", ctypes.c_ulong), ("root", ctypes.c_ulong),
            ("subwindow", ctypes.c_ulong), ("time", ctypes.c_ulong),
            ("x", ctypes.c_int), ("y", ctypes.c_int), ("x_root", ctypes.c_int), ("y_root", ctypes.c_int),
            ("state", ctypes.c_uint), ("is_hint", ctypes.c_char), ("same_screen", ctypes.c_int),
        ]

    class XKeyEvent(ctypes.Structure):
        _fields_ = [
            ("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
            ("display", ctypes.c_void_p), ("window", ctypes.c_ulong), ("root", ctypes.c_ulong),
            ("subwindow", ctypes.c_ulong), ("time", ctypes.c_ulong),
            ("x", ctypes.c_int), ("y", ctypes.c_int), ("x_root", ctypes.c_int), ("y_root", ctypes.c_int),
            ("state", ctypes.c_uint), ("keycode", ctypes.c_uint), ("same_screen", ctypes.c_int),
        ]

    ev = XEvent()
    while True:
        while x11.XPending(display):
            x11.XNextEvent(display, ctypes.byref(ev))
            if ev.type == 12:  # Expose
                manager.redraw()
            elif ev.type == 4:  # ButtonPress
                bev = ctypes.cast(ctypes.byref(ev), ctypes.POINTER(XButtonEvent)).contents
                if bev.button == 4:
                    manager.handle_scroll(-1)
                elif bev.button == 5:
                    manager.handle_scroll(1)
                else:
                    manager.handle_click(bev.x, bev.y, bev.button)
            elif ev.type == 5:  # ButtonRelease
                manager.is_dragging_scrollbar = False
            elif ev.type == 6:  # MotionNotify
                mev = ctypes.cast(ctypes.byref(ev), ctypes.POINTER(XMotionEvent)).contents
                manager.handle_motion(mev.x, mev.y)
            elif ev.type == 2:  # KeyPress
                kev = ctypes.cast(ctypes.byref(ev), ctypes.POINTER(XKeyEvent)).contents
                keysym = x11.XKeycodeToKeysym(display, kev.keycode, 0)
                manager.handle_key(keysym)
        time.sleep(0.02)

# ----------------------------------------------------------------------
# Wayland Window Backend
# ----------------------------------------------------------------------
def run_wayland():
    run_cairo_gtk(CairoAutostartManager, "MDEON Autostart Manager", 860, 580, 600, 400)

# ----------------------------------------------------------------------
# CLI Interface & Entrypoint
# ----------------------------------------------------------------------
def print_cli_help():
    print("""mdeon-autostart - MDEON Autostart Manager (Zero-Toolkit)

Usage:
  mdeon-autostart                      Open Cairo UI (Auto X11 / Wayland)
  mdeon-autostart --session            Start enabled autostart entries sequentially
  mdeon-autostart --session-parallel   Start enabled autostart entries in parallel
  mdeon-autostart --dry-run            Print execution breakdown without launching
  mdeon-autostart --list               List known autostart entries
  mdeon-autostart --enable FILE.desktop Enable an autostart entry
  mdeon-autostart --disable FILE.desktop Disable an autostart entry
  mdeon-autostart --delete FILE.desktop Delete a user autostart entry
  mdeon-autostart --help               Show this help
""")

def cli_list():
    collect_entries()
    for base in sorted(ENTRY_FILE.keys()):
        fn = ENTRY_FILE[base]
        df = DesktopFile(fn)
        st = "enabled" if df.enabled() else "disabled"
        rn = "running" if is_process_running(df.get("Exec", ""), base) else "idle"
        src = "user" if is_inside_dir(fn, USER_DIR) else "system"
        print(f"{base}\t{st}\t{rn}\t{src}\t{df.get('Name', base)}\t{clean_exec(strip_quotes(df.get('Exec', '')))}")

def main():
    global DRY_RUN, USE_PARALLEL
    args = sys.argv[1:]
    if args:
        if args[0] in ("-h", "--help"):
            print_cli_help()
            return 0
        if args[0] == "--session":
            USE_PARALLEL = False
            execute_entries()
            return 0
        if args[0] == "--session-parallel":
            USE_PARALLEL = True
            execute_entries()
            return 0
        if args[0] == "--dry-run":
            DRY_RUN = True
            print(execute_entries())
            return 0
        if args[0] == "--list":
            cli_list()
            return 0
        if args[0] == "--enable" and len(args) > 1:
            collect_entries()
            set_entry_enabled_by_base(args[1], True)
            print(f"Enabled: {args[1]}")
            return 0
        if args[0] == "--disable" and len(args) > 1:
            collect_entries()
            set_entry_enabled_by_base(args[1], False)
            print(f"Disabled: {args[1]}")
            return 0
        if args[0] == "--delete" and len(args) > 1:
            target = os.path.join(USER_DIR, os.path.basename(args[1]))
            if os.path.isfile(target):
                os.remove(target)
                print(f"Deleted: {target}")
            else:
                print(f"Entry not found or not in user directory: {args[1]}", file=sys.stderr)
                return 1
            return 0

    # UI Launch Dispatcher
    if SESSION_TYPE == "wayland" and os.environ.get("WAYLAND_DISPLAY"):
        try:
            run_wayland()
            return 0
        except Exception as e:
            if not os.environ.get("DISPLAY"):
                logger.error("Unable to start Autostart Manager in Wayland: %s", e)
                return 1
            logger.warning("Wayland window startup failed (%s); falling back to X11.", e)

    if not os.environ.get("DISPLAY"):
        logger.error("No graphical display available (Wayland or X11).")
        return 1
    try:
        run_x11()
        return 0
    except Exception as e:
        logger.error("Unable to start Autostart Manager: %s", e)
        return 1

if __name__ == "__main__":
    sys.exit(main())
