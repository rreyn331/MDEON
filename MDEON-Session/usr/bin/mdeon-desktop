HAVE_WAYLAND = False
if os.environ.get("WAYLAND_DISPLAY"):
    try:
        from pywayland.client import Display as WlDisplay
        try:
            from pywayland.protocols.wayland import (
                WlBuffer,
                WlCompositor,
                WlKeyboard,
                WlPointer,
                WlShm,
                WlShmPool,
                WlSeat,
                WlSurface,
            )
            from pywayland.protocols.wlr_layer_shell_unstable_v1 import (
                ZwlrLayerShellV1,
                ZwlrLayerSurfaceV1,
            )
        except ImportError:
            from pywayland.protocol.wayland import (
                WlBuffer,
                WlCompositor,
                WlKeyboard,
                WlPointer,
                WlShm,
                WlShmPool,
                WlSeat,
                WlSurface,
            )
            from pywayland.protocol_core import Argument, ArgumentType, Interface, Proxy

            class ZwlrLayerShellV1(Interface):
                name = "zwlr_layer_shell_v1"
                version = 4

            class ZwlrLayerSurfaceV1(Interface):
                name = "zwlr_layer_surface_v1"
                version = 4

            class ZwlrLayerShellV1Proxy(Proxy):
                interface = ZwlrLayerShellV1

                @ZwlrLayerShellV1.request(
                    Argument(ArgumentType.NewId, interface=ZwlrLayerSurfaceV1),
                    Argument(ArgumentType.Object, interface=WlSurface),
                    Argument(ArgumentType.Object, interface=None, nullable=True),
                    Argument(ArgumentType.Uint),
                    Argument(ArgumentType.String),
                )
                def get_layer_surface(self, surface, output, layer, namespace):
                    return self._marshal_constructor(
                        0, ZwlrLayerSurfaceV1, surface, output, layer, namespace
                    )

            class ZwlrLayerSurfaceV1Proxy(Proxy):
                interface = ZwlrLayerSurfaceV1

                @ZwlrLayerSurfaceV1.request(
                    Argument(ArgumentType.Uint),
                    Argument(ArgumentType.Uint),
                )
                def set_size(self, width, height):
                    self._marshal(0, width, height)

                @ZwlrLayerSurfaceV1.request(Argument(ArgumentType.Uint))
                def set_anchor(self, anchor):
                    self._marshal(1, anchor)

                @ZwlrLayerSurfaceV1.request(Argument(ArgumentType.Int))
                def set_exclusive_zone(self, zone):
                    self._marshal(2, zone)

                @ZwlrLayerSurfaceV1.request(
                    Argument(ArgumentType.Int),
                    Argument(ArgumentType.Int),
                    Argument(ArgumentType.Int),
                    Argument(ArgumentType.Int),
                )
                def set_margin(self, top, right, bottom, left):
                    self._marshal(3, top, right, bottom, left)

                @ZwlrLayerSurfaceV1.request(Argument(ArgumentType.Uint))
                def set_keyboard_interactivity(self, keyboard_interactivity):
                    self._marshal(4, keyboard_interactivity)

                @ZwlrLayerSurfaceV1.request(
                    Argument(ArgumentType.Object, interface=None)
                )
                def get_popup(self, popup):
                    self._marshal(5, popup)

                @ZwlrLayerSurfaceV1.request(Argument(ArgumentType.Uint))
                def ack_configure(self, serial):
                    self._marshal(6, serial)

                @ZwlrLayerSurfaceV1.request()
                def destroy(self):
                    self._marshal(7)
                    self._destroy()

                @ZwlrLayerSurfaceV1.request(
                    Argument(ArgumentType.Uint), version=2
                )
                def set_layer(self, layer):
                    self._marshal(8, layer)

                @ZwlrLayerSurfaceV1.event(
                    Argument(ArgumentType.Uint),
                    Argument(ArgumentType.Uint),
                    Argument(ArgumentType.Uint),
                )
                def configure(self, serial, width, height):
                    self._post_event(0, serial, width, height)

                @ZwlrLayerSurfaceV1.event()
                def closed(self):
                    self._post_event(1)

            ZwlrLayerShellV1._gen_c()
            ZwlrLayerShellV1.proxy_class = ZwlrLayerShellV1Proxy
            ZwlrLayerSurfaceV1._gen_c()
            ZwlrLayerSurfaceV1.proxy_class = ZwlrLayerSurfaceV1Proxy

        HAVE_WAYLAND = True
    except ImportError:
        HAVE_WAYLAND = False

